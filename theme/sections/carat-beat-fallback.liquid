{%- comment -%}
  LET US BEAT THEIR PRICE: plain-language explainer for the 10% fallback.
  Explanation only. The binding wording is the policy-terms section, which
  is fetched from the app and is not duplicated here.
{%- endcomment -%}
{{ 'carat-beat-price.css' | asset_url | stylesheet_tag }}

<section id="{{ section.settings.anchor | handleize }}" class="cbp cbp-fb color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient" aria-labelledby="CbpFb-{{ section.id }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="cbp-fb__panel">
      <div class="cbp-fb__head">
        {%- if section.settings.tag != blank -%}<p class="cbp-tag">{{ section.settings.tag | escape }}</p>{%- endif -%}
        <h2 class="cbp-detail__heading" id="CbpFb-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.intro != blank -%}<div class="cbp-fb__intro">{{ section.settings.intro }}</div>{%- endif -%}
        {%- if section.settings.offer != blank -%}<p class="cbp-fb__offer">{{ section.settings.offer | escape }}</p>{%- endif -%}
      </div>
      <div class="cbp-fb__cols">
        {%- liquid
          assign cols = 'yes,no,info' | split: ','
        -%}
        {%- for c in cols -%}
          {%- liquid
            case c
              when 'yes'
                assign t = section.settings.eligible_title
                assign items = section.settings.eligible_items
                assign ic = 'check'
              when 'no'
                assign t = section.settings.excluded_title
                assign items = section.settings.excluded_items
                assign ic = 'cross'
              else
                assign t = section.settings.rules_title
                assign items = section.settings.rules_items
                assign ic = 'check'
            endcase
          -%}
          {%- if items != blank -%}
            <div class="cbp-fb__col">
              <h3 class="cbp-fb__col-title">{{ t | escape }}</h3>
              <ul class="cbp-fb__list cbp-fb__list--{{ c }}" role="list">
                {%- assign lines = items | newline_to_br | split: '<br />' -%}
                {%- for line in lines -%}
                  {%- assign l = line | strip -%}
                  {%- if l != blank -%}<li>{% render 'carat-bp-icon', name: ic %}<span>{{ l | escape }}</span></li>{%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.foot != blank -%}<div class="cbp-fb__foot">{{ section.settings.foot }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Beat price fallback",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section id (jump target)", "default": "fallback" },
    { "type": "text", "id": "tag", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How the 10% fallback works" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "offer", "label": "Offer line", "default": "10% off one eligible CaratForUs purchase, up to $100 maximum savings." },
    { "type": "text", "id": "eligible_title", "label": "Eligible column title", "default": "Can be used on" },
    { "type": "textarea", "id": "eligible_items", "label": "Eligible items (one per line)" },
    { "type": "text", "id": "excluded_title", "label": "Excluded column title", "default": "Cannot be used on" },
    { "type": "textarea", "id": "excluded_items", "label": "Excluded items (one per line)" },
    { "type": "text", "id": "rules_title", "label": "Rules column title", "default": "Good to know" },
    { "type": "textarea", "id": "rules_items", "label": "Rules (one per line)" },
    { "type": "richtext", "id": "foot", "label": "Footnote" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "presets": [{ "name": "Beat price fallback" }]
}
{% endschema %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
