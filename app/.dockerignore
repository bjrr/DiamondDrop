# Keep the build context small and, more importantly, keep secrets and local
# state out of the image entirely.
.env
.env.*
!.env.example

node_modules
build
.react-router
.vite

# Local-only tooling and evidence.
tests/live
*.log
.DS_Store

# Version control and CI.
.git
.github

# Shopify CLI local state — the tunnel URL in here is ephemeral and must never
# be baked into an image.
.shopify
