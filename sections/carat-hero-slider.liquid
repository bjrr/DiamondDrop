{%- comment -%}
  CARAT HERO — STATIONARY COPY, ROTATING PHOTOGRAPHY
  ===========================================================================
  The message never moves. One headline, one subheading, one pair of CTAs,
  rendered ONCE and never touched. Only the photograph behind them
  crossfades.

  WHY THIS SHAPE. The first build rotated whole slides — copy and image
  together — which asked the visitor to re-read a different hero every few
  seconds and meant the CTA they were reaching for could change underneath
  them. Rotating only the art gives the variety without the cost: nothing
  reflows, nothing is re-read, and the button stays where the hand is going.

  CONSEQUENCES FOR SEMANTICS. Because no text changes, there is no live
  region and nothing is announced. Announcing "slide 2 of 3" when the only
  change is a background photograph is noise to a screen reader, not help.
  The images are real content, so each keeps its alt text and only the
  visible one is exposed; the inactive ones are aria-hidden.

  WHY THE DOTS STAY. Under prefers-reduced-motion the rotation never starts,
  so without a control a visitor would only ever see the first photograph.
  The dots are how they reach the others. They are small, unobtrusive, and
  real buttons. There are deliberately no large arrows — there is no
  sequence to step through, only a few views of the same message.

  NO LAYOUT SHIFT BY CONSTRUCTION. Every image and the copy share ONE grid
  cell with a fixed min-height, so the section's height never depends on
  which photograph is showing.

  PERFORMANCE. Only the first image is eager with fetchpriority high; the
  rest are lazy.
{%- endcomment -%}

{{ 'carat-editorial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'carat-hero-slider.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign shots = section.blocks | where: 'type', 'image'
  assign count = shots.size
  assign autoplay = section.settings.autoplay
  if count < 2
    assign autoplay = false
  endif
-%}

<section
  class="carat-hslider carat-hslider--{{ section.settings.height }} carat-hslider--{{ section.settings.tone }}"
  data-carat-hslider
  data-autoplay="{% if autoplay %}true{% else %}false{% endif %}"
  data-interval="{{ section.settings.interval | times: 1000 }}"
  aria-label="{{ section.settings.aria_label | default: 'Featured jewelry' | escape }}"
>
  {%- comment -%} The rotating photography. Decorative in structure, real in
  content: each image keeps its alt text. {%- endcomment -%}
  <div class="carat-hslider__stage" data-carat-hslider-stage>
    {%- if count == 0 -%}
      <div class="carat-hshot is-active">
        <div class="carat-hshot__img carat-hshot__img--placeholder"></div>
      </div>
    {%- else -%}
      {%- for block in shots -%}
        {%- liquid
          assign d = block.settings.image_desktop
          assign m = block.settings.image_mobile
          if m == blank
            assign m = d
          endif
        -%}
        <div
          class="carat-hshot{% if forloop.first %} is-active{% endif %}"
          data-carat-hshot
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- if d != blank -%}
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ m | image_url: width: 750 }} 750w,
                  {{ m | image_url: width: 1100 }} 1100w,
                  {{ m | image_url: width: 1500 }} 1500w
                "
                sizes="100vw"
              >
              <img
                src="{{ d | image_url: width: 1800 }}"
                srcset="
                  {{ d | image_url: width: 1200 }} 1200w,
                  {{ d | image_url: width: 1800 }} 1800w,
                  {{ d | image_url: width: 2400 }} 2400w
                "
                sizes="100vw"
                alt="{{ d.alt | escape }}"
                width="{{ d.width }}"
                height="{{ d.height }}"
                {% if forloop.first %}
                  loading="eager"
                  fetchpriority="high"
                {% else %}
                  loading="lazy"
                  fetchpriority="low"
                {% endif %}
                class="carat-hshot__img"
              >
            </picture>
          {%- else -%}
            <div class="carat-hshot__img carat-hshot__img--placeholder"></div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="carat-hslide__veil"></div>

  {%- comment -%} The message. Rendered once, never rotated. {%- endcomment -%}
  <div class="carat-hslide__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="carat-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="carat-hslide__heading">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="carat-hslide__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
      <div class="carat-hslide__actions">
        {%- if section.settings.cta_label != blank -%}
          <a class="button carat-button" href="{{ section.settings.cta_link | default: '#' }}">
            {{- section.settings.cta_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="button button--secondary carat-button" href="{{ section.settings.cta2_link | default: '#' }}">
            {{- section.settings.cta2_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.media_credit != blank -%}
      <p class="carat-hslide__credit">{{ section.settings.media_credit | escape }}</p>
    {%- endif -%}
  </div>

  {%- if count > 1 -%}
    <div class="carat-hslider__dots" data-carat-hslider-dots>
      {%- for block in shots -%}
        <button
          type="button"
          class="carat-hslider__dot{% if forloop.first %} is-active{% endif %}"
          data-carat-hslider-dot
          data-index="{{ forloop.index0 }}"
          aria-label="Show photograph {{ forloop.index }} of {{ count }}"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Carat hero",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Message (stationary — never rotates)"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fine jewelry. Smarter ways to buy." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "cta_label", "label": "Primary button" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "text", "id": "media_credit", "label": "Image credit / label" },
    {
      "type": "header",
      "content": "Rotation"
    },
    { "type": "checkbox", "id": "autoplay", "label": "Crossfade automatically", "default": true },
    {
      "type": "range",
      "id": "interval",
      "label": "Seconds per photograph",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 6,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "medium",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "tall", "label": "Tall" },
        { "value": "full", "label": "Full screen" }
      ]
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "default": "overlay",
      "options": [
        { "value": "overlay", "label": "Overlay — dark copy over a bright image" },
        { "value": "dark", "label": "Dark — light copy over a dark image" }
      ]
    },
    { "type": "text", "id": "aria_label", "label": "Section label (screen readers)", "default": "Featured jewelry" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Photograph",
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "Desktop image (wide)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (tall crop)" }
      ]
    }
  ],
  "presets": [{ "name": "Carat hero", "blocks": [{ "type": "image" }] }]
}
{% endschema %}
