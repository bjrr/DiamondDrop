{%- comment -%}
  LET US BEAT THEIR PRICE: hero.
  Headline, one line of promise, short intro, three path cards that jump to
  their detail sections, one primary CTA to the form, and a trust strip.
  Every string, image and link is a setting or a block setting.
{%- endcomment -%}
{{ 'carat-editorial.css' | asset_url | stylesheet_tag }}
{{ 'carat-beat-price.css' | asset_url | stylesheet_tag }}

<section class="cbp cbp-hero color-{{ section.settings.color_scheme | default: 'scheme-1' }} gradient" aria-labelledby="CbpHeroTitle-{{ section.id }}">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="cbp-hero__copy">
      <h1 class="cbp-hero__title" id="CbpHeroTitle-{{ section.id }}">{{ section.settings.heading | default: page.title | escape }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="cbp-hero__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="cbp-hero__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </div>

    {%- assign cards = section.blocks | where: 'type', 'card' -%}
    {%- if cards.size > 0 -%}
      <ul class="cbp-cards" role="list">
        {%- for block in cards -%}
          <li class="cbp-card" {{ block.shopify_attributes }}>
            <div class="cbp-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag:
                  widths: '400, 600, 900',
                  sizes: '(min-width: 750px) 30vw, 92vw',
                  loading: 'eager',
                  alt: block.settings.image.alt | default: ''
                }}
              {%- else -%}
                {% render 'carat-bp-icon', name: block.settings.icon %}
              {%- endif -%}
            </div>
            <div class="cbp-card__body">
              <h2 class="cbp-card__label">{% render 'carat-bp-icon', name: block.settings.icon %}<span>{{ block.settings.title | escape }}</span></h2>
              {%- if block.settings.line1 != blank -%}<p class="cbp-card__line1">{{ block.settings.line1 | escape }}</p>{%- endif -%}
              {%- if block.settings.line2 != blank -%}<p class="cbp-card__line2">{{ block.settings.line2 | escape }}</p>{%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <a class="cbp-card__more" href="#{{ block.settings.target | handleize }}">
                  {{- block.settings.link_label | escape -}}
                  <span class="visually-hidden">: {{ block.settings.title | escape }}</span>
                  {% render 'carat-bp-icon', name: 'arrow' %}
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <div class="cbp-hero__actions">
        <a class="button cbp-cta" href="#{{ section.settings.cta_target | handleize }}">
          {{- section.settings.cta_label | escape -}}
          {% render 'carat-bp-icon', name: 'arrow' %}
        </a>
      </div>
    {%- endif -%}

    {%- assign trust = section.blocks | where: 'type', 'trust' -%}
    {%- if trust.size > 0 -%}
      <ul class="cbp-trust" role="list">
        {%- for block in trust -%}
          <li class="cbp-trust__item" {{ block.shopify_attributes }}>
            {% render 'carat-bp-icon', name: block.settings.icon %}
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Beat price hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let Us Beat Their Price" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Found a better jewelry price? Give us the chance to beat it." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Whether you have a recent custom quote, found a piece advertised online, or are considering another Group Buy, send it to us. Every submission is reviewed by a person.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Submit a Price" },
    { "type": "text", "id": "cta_target", "label": "Button jumps to section id", "default": "submit-a-price" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Path card",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "quote", "options": [
          { "value": "quote", "label": "Quote" }, { "value": "online", "label": "Online" }, { "value": "group", "label": "Group" }, { "value": "diamond", "label": "Diamond" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Custom quote" },
        { "type": "text", "id": "line1", "label": "Line 1" },
        { "type": "text", "id": "line2", "label": "Line 2" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn More" },
        { "type": "text", "id": "target", "label": "Link jumps to section id" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust point",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
          { "value": "shield", "label": "Shield" }, { "value": "tag", "label": "Tag" }, { "value": "person", "label": "Person" }, { "value": "diamond", "label": "Diamond" }
        ] },
        { "type": "text", "id": "text", "label": "Text", "default": "Every submission reviewed by a person" }
      ]
    }
  ],
  "presets": [{ "name": "Beat price hero" }]
}
{% endschema %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
