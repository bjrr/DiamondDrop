{%- comment -%}
  Line icons for the Let Us Beat Their Price page. Decorative only.
  Usage: {% render 'carat-bp-icon', name: 'quote' %}
{%- endcomment -%}
<svg aria-hidden="true" focusable="false" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
{%- case name -%}
  {%- when 'quote' -%}
    <rect x="11" y="8" width="26" height="34" rx="3"/><rect x="18" y="5" width="12" height="6" rx="2"/><path d="M17 20h14M17 27h14M17 34h9"/>
  {%- when 'online' -%}
    <rect x="6" y="9" width="36" height="24" rx="2"/><path d="M18 40h12M24 33v7"/>
  {%- when 'group' -%}
    <circle cx="24" cy="15" r="5"/><circle cx="12" cy="19" r="4"/><circle cx="36" cy="19" r="4"/><path d="M15 38c0-5 4-9 9-9s9 4 9 9M4 38c0-4 3-7 8-7 1.5 0 3 .3 4 1M44 38c0-4-3-7-8-7-1.5 0-3 .3-4 1"/>
  {%- when 'shield' -%}
    <path d="M24 5l15 5v12c0 10-6.5 17-15 21C15.5 39 9 32 9 22V10z"/><path d="M17 24l5 5 9-10"/>
  {%- when 'tag' -%}
    <path d="M6 24V8h16l20 20-14 14z"/><circle cx="15" cy="16" r="3"/>
  {%- when 'person' -%}
    <circle cx="24" cy="16" r="8"/><path d="M9 42c0-8 7-13 15-13s15 5 15 13"/>
  {%- when 'diamond' -%}
    <path d="M6 18l8-10h20l8 10-18 22z"/><path d="M6 18h36M18 8l-4 10 10 22 10-22-4-10"/>
  {%- when 'check' -%}
    <circle cx="24" cy="24" r="18"/><path d="M16 24l6 6 11-12"/>
  {%- when 'cross' -%}
    <circle cx="24" cy="24" r="18"/><path d="M18 18l12 12M30 18L18 30"/>
  {%- when 'arrow' -%}
    <path d="M18 10l14 14-14 14"/>
  {%- else -%}
    <path d="M6 18l8-10h20l8 10-18 22z"/>
{%- endcase -%}
</svg>
