{%- comment -%}
  SHAPE NAVIGATION.

  A SEPARATE SECTION FROM THE FEED, deliberately. The feed area is replaced
  wholesale when a provider is connected; this is not. The brief says shape
  navigation "should eventually be able to pass the selected shape into
  whichever provider we choose", which means it has to OUTLIVE the switch —
  so it cannot live inside the part that gets replaced.

  Each shape carries `?shape=<name>` to the search area. Today the page
  acknowledges the choice in its own copy and nothing more; when a provider
  is connected, these hrefs are the single place a shape gets handed over,
  and they are theme-editor settings so that handover needs no code.

  NO COUNTS. "Round (1,284)" would be inventory we do not have, and a count
  that is wrong the day a feed connects is worse than no count at all.

  The shapes themselves are drawn outlines — see
  snippets/carat-diamond-shape-icon.liquid for why they are SVG rather than
  photographs.
{%- endcomment -%}

{{ 'carat-diamonds.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign scheme = section.settings.color_scheme | default: 'scheme-2'
  assign base = section.settings.link_base | default: '?shape='
  assign suffix = section.settings.link_suffix | default: '#diamond-search'

  comment
    One ordered list, so the grid order is editable without touching markup
    and the labels stay in step with the icon snippet's own case statement.
  endcomment
  assign shapes = 'round,oval,emerald,radiant,cushion,pear,marquise,princess,asscher,heart' | split: ','
  assign labels = 'Round,Oval,Emerald,Radiant,Cushion,Pear,Marquise,Princess,Asscher,Heart' | split: ','
-%}

<section class="cd-section color-{{ scheme }} gradient">
  <div class="page-width">
    <div class="cd-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="carat-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="cd-head__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="cd-head__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <p class="cd-head__text" data-cd-context-holder hidden>
        {{ 'Noted:' }} <strong data-cd-shape-context></strong>. {{ 'We will start there when the marketplace opens.' }}
      </p>
    </div>

    <ul class="cd-shapes__grid" role="list">
      {%- for shape in shapes -%}
        {%- assign label = labels[forloop.index0] -%}
        <li>
          <a
            class="cd-shape"
            href="{{ base }}{{ shape }}{{ suffix }}"
            data-cd-shape="{{ shape }}"
          >
            {% render 'carat-diamond-shape-icon', shape: shape, size: 44 %}
            <span class="cd-shape__name">{{ label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Carat diamond shapes",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shapes" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start with a shape" },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting copy",
      "default": "Shape sets the character of a diamond before anything else does. Pick the one you are drawn to, or compare several."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    { "type": "header", "content": "Where a shape leads" },
    {
      "type": "paragraph",
      "content": "Each shape's link is built as base + shape name + suffix. Repoint these at a connected provider's own shape parameter when one is live; no code change is needed."
    },
    { "type": "text", "id": "link_base", "label": "Link base", "default": "?shape=" },
    { "type": "text", "id": "link_suffix", "label": "Link suffix", "default": "#diamond-search" }
  ],
  "presets": [{ "name": "Carat diamond shapes" }]
}
{% endschema %}
