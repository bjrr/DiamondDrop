// CaratForUs MVP1 — Slice 0 schema.
//
// Only the six tables specified in docs/specs/SLICE-0-FOUNDATION.md §0.3:
// policy_version, acknowledgment, snapshot, audit_event, webhook_event,
// idempotency_key. Pricing/campaign/RMA/warranty/quote tables are explicitly
// out of scope for this slice and ship with their own specs.
//
// Money columns convention (established here for all later slices): BIGINT
// minor units + a CHAR(3) currency column. None of Slice 0's own tables
// store money, but this is the documented pattern later models must follow
// (see docs/specs/SLICE-0-FOUNDATION.md §0.3 and app/app/domain/money).
//
// policy_version, acknowledgment, snapshot, and audit_event are append-only
// at the database level — see prisma/migrations/20260913000100_append_only_evidence_triggers.
// The Prisma schema cannot express a trigger, so this comment is the only
// place that fact is visible from the schema file itself; the migration SQL
// is authoritative.
//
// ---------------------------------------------------------------------------
// MONEY COLUMN CONVENTION (F-16). Every monetary amount is stored as two
// columns: BIGINT minor units + CHAR(3) ISO-4217 currency. Never NUMERIC,
// never DOUBLE PRECISION, never a bare integer without its currency.
//
//   bankPaymentPriceMinorUnits     BigInt  @map("bank_payment_price_minor_units")
//   currency                String  @db.Char(3)
//
// Prisma maps BIGINT to a JS `bigint`. `JSON.stringify` THROWS on a bigint —
// "Do not know how to serialize a BigInt". Never return a raw row across a
// JSON boundary. Repositories convert at their edge:
//
//   Money.fromMinorUnits(row.bankPaymentPriceMinorUnits, row.currency)
//
// and Money.toJSON() yields { amountMinorUnits: string, currency } — lossless
// and JSON-safe. See app/app/domain/money/money.ts.
//
// RATE COLUMNS are different and are NOT money: a price per gram, a price per
// carat, a percentage, a gram weight or a ring size is NUMERIC(p,s) with the
// scale fixed below. Prisma returns these as Prisma.Decimal. Cross into the
// domain with `new MoneyDecimal(d.toString())`. `.toNumber()` is banned —
// the money-safety scan fails on it.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// POOLED FOR THE APP, DIRECT FOR MIGRATIONS — and the split is required,
  /// not a tuning preference.
  ///
  /// Fly Managed Postgres hands out a PgBouncer endpoint, and PgBouncer in
  /// transaction-pooling mode does not carry session state across statements.
  /// `prisma migrate deploy` takes a session-level ADVISORY LOCK to serialise
  /// concurrent deploys; through a transaction pooler that lock is taken on
  /// one backend and looked for on another, so the migration either hangs or
  /// reports a failure that says nothing about pooling.
  ///
  /// `directUrl` is used by the Prisma CLI only — migrate, db push,
  /// introspect. The application keeps using the pooled `url`, which is the
  /// right endpoint for a fleet of short-lived request handlers.
  ///
  /// Locally both point at the same Postgres and nothing changes.
  directUrl = env("DIRECT_URL")
}

enum ActorType {
  staff
  system
  customer

  @@map("actor_type")
}

enum IdempotencyStatus {
  pending
  succeeded
  failed
  in_doubt

  @@map("idempotency_status")
}

/// Append-only. See migration 20260913000100 for the enforcing trigger.
model PolicyVersion {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String
  version       Int
  effectiveFrom DateTime @map("effective_from")
  text          String
  contentHash   String   @map("content_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  acknowledgments Acknowledgment[]

  @@unique([slug, version])
  @@index([slug])
  @@map("policy_version")
}

/// Append-only. See migration 20260913000100 for the enforcing trigger.
/// Writing a row requires exact displayed text, a policy version, a
/// timestamp, and an explicit affirmative-action label — see
/// app/app/domain/evidence/acknowledgment.ts. There is no boolean
/// "accepted" column: the existence of the row, with these fields
/// populated, is the evidence.
model Acknowledgment {
  id                     String        @id @default(uuid()) @db.Uuid
  exactText              String        @map("exact_text")
  policyVersionId        String        @map("policy_version_id") @db.Uuid
  policyVersion          PolicyVersion @relation(fields: [policyVersionId], references: [id])
  acknowledgedAt         DateTime      @map("acknowledged_at")
  affirmativeActionLabel String        @map("affirmative_action_label")

  // Nullable reference columns — exactly the set required by
  // docs/specs/SLICE-0-FOUNDATION.md §0.5. Populate whichever apply to the
  // transaction; all may be null except at least a reasonable minimum
  // expected by the calling domain (enforced by that domain, not here).
  customerRef   String? @map("customer_ref")
  orderRef      String? @map("order_ref")
  cartRef       String? @map("cart_ref")
  campaignRef   String? @map("campaign_ref")
  submissionRef String? @map("submission_ref")
  productRef    String? @map("product_ref")
  variantRef    String? @map("variant_ref")
  sourceIp      String? @map("source_ip")
  userAgent     String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  /// Slice 3 M12 back-relation only — required by Prisma for the FK on
  /// `LuxuryStealOrderCheck.matchedAcknowledgmentId`. Adds no column here and
  /// changes nothing about how Acknowledgment rows are written or read.
  luxuryStealOrderChecks              LuxuryStealOrderCheck[]
  /// Slice 5 M13 back-relations only — required by Prisma for the two NOT
  /// NULL FKs on `WarrantyClaim` (criterion 154: both acknowledgments are
  /// mandatory, not optional). Adds no column here.
  warrantyClaimAccuracyCertifications WarrantyClaim[]         @relation("WarrantyClaimAccuracyCertification")
  warrantyClaimCoverageNotEstablished WarrantyClaim[]         @relation("WarrantyClaimCoverageNotEstablished")
  /// Slice 4 M-rma-request back-relation only — required by Prisma for the
  /// NOT NULL FK on `RmaRequest.returnPolicyAcknowledgmentId` (criterion
  /// 180). Adds no column here.
  rmaRequests                         RmaRequest[]

  @@index([policyVersionId])
  @@index([customerRef])
  @@index([orderRef])
  @@index([campaignRef])
  @@map("acknowledgment")
}

/// Append-only. See migration 20260913000100 for the enforcing trigger.
model Snapshot {
  id          String   @id @default(uuid()) @db.Uuid
  kind        String
  payload     Json
  contentHash String   @map("content_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  priceCalculations PriceCalculation[]
  groupBuyCampaigns GroupBuyCampaign[]

  @@index([kind])
  @@index([contentHash])
  @@map("snapshot")
}

/// Append-only. See migration 20260913000100 for the enforcing trigger.
model AuditEvent {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType @map("actor_type")
  actorRef   String?   @map("actor_ref")
  action     String
  entityType String    @map("entity_type")
  entityId   String    @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@map("audit_event")
}

/// Mutable (not append-only): processedAt/error are updated after receipt.
/// Deduplication relies on the UNIQUE constraint on shopifyEventId, not a
/// read-then-write check, so concurrent deliveries of the same event cannot
/// both pass.
model WebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  shopifyEventId String    @unique @map("shopify_event_id")
  topic          String
  shopDomain     String?   @map("shop_domain")
  rawBody        String    @map("raw_body")
  receivedAt     DateTime  @default(now()) @map("received_at")
  /// Set every time a caller successfully claims this delivery for
  /// processing (initial insert, retry-after-failure, or stale reclaim).
  /// Drives stale-claim detection: a row still unprocessed with no recorded
  /// error whose claimedAt is older than the staleness threshold is treated
  /// as a crashed attempt and may be reclaimed.
  claimedAt      DateTime? @map("claimed_at")
  processedAt    DateTime? @map("processed_at")
  error          String?

  @@index([topic])
  @@index([processedAt, claimedAt])
  @@map("webhook_event")
}

/// Mutable (not append-only): status/result are updated after the wrapped
/// operation completes. The UNIQUE constraint on `key` is what makes
/// "commit before call" safe under concurrency — see
/// app/app/domain/idempotency.
model IdempotencyKey {
  id             String            @id @default(uuid()) @db.Uuid
  key            String            @unique
  operationType  String            @map("operation_type")
  status         IdempotencyStatus @default(pending)
  requestPayload Json?             @map("request_payload")
  resultPayload  Json?             @map("result_payload")
  errorMessage   String?           @map("error_message")
  createdAt      DateTime          @default(now()) @map("created_at")
  completedAt    DateTime?         @map("completed_at")

  @@index([operationType])
  @@index([status])
  @@map("idempotency_key")
}

// =============================================================================
// Slice 1 — Cost Libraries, Buy Now Pricing Engine, Price Review & Sync Job
// (docs/specs/SLICE-1-PRICING.md). Layering per §4.0: metal_price, stone_cost,
// cost_component and pricing_profile are L1 raw inputs (append-only, staff-
// or feed-entered, effective-dated). master_product/master_variant/
// ring_size_band/variant_weight_override/master_variant_stone are the design
// definition the engine reads. price_calculation is the L6 immutable record
// of one computed price; price_sync_intent is the mutable review/sync state
// machine layered on top of it (architect ruling, §7.2, amending
// docs/ARCHITECTURE-MVP1.md §4: immutable calculation vs. mutable review).
//
// NULL-in-UNIQUE-INDEX CAVEAT (judgement call, flagged for architect
// review): several natural-key uniqueness rules below include nullable
// columns (e.g. master_variant's bandId, stone_cost's color/clarity/
// cutGrade/labStatus/supplierRef wildcards). Postgres treats each NULL in a
// UNIQUE index as distinct from every other NULL, so a plain multi-column
// `@@unique` does NOT reject two rows that are "duplicates" only because
// they share the same NULL(s) — e.g. two stone_cost rows with an identical
// non-null key prefix and every wildcard column NULL. Spec §7.2 states each
// of these constraints in plain natural-key form without asking for a
// COALESCE/partial-index workaround (unlike price_sync_intent, where the
// spec explicitly calls for a partial index), so this migration implements
// them as literal multi-column `@@unique`s and relies on effective-dating
// application logic (§4.3 specificity ordering; `selectMostSpecific`, T5)
// to keep wildcard rows from being written as accidental exact duplicates.
// Flagging rather than silently "fixing" this with an uninstructed COALESCE
// index, per the instruction not to invent scope beyond the approved spec.

enum Metal {
  sterling_silver
  gold
  platinum

  @@map("metal")
}

/// Value names are not valid bare Prisma identifiers (leading digits), so
/// each is mapped to the spec's literal string (§7.2: "925", "10k", "14k",
/// "18k", "pt950").
enum Purity {
  SILVER_925   @map("925")
  GOLD_10K     @map("10k")
  GOLD_14K     @map("14k")
  GOLD_18K     @map("18k")
  PLATINUM_950 @map("pt950")

  @@map("purity")
}

enum MetalPriceSource {
  manual
  feed

  @@map("metal_price_source")
}

/// §4.3: fixed list, controlling.
enum StoneType {
  natural_diamond
  lab_diamond
  moissanite
  colored_gemstone
  accent_melee

  @@map("stone_type")
}

enum StoneCostKind {
  per_stone
  per_carat

  @@map("stone_cost_kind")
}

/// §4.2 input inventory, one value per cost input row. `metal_loss` is
/// seeded explicitly as a zero-rate `cost_component` (§4.5) rather than
/// treated as absent.
enum CostComponentType {
  metal_loss
  cad
  casting
  setting
  polishing
  assembly
  qc
  packaging
  shipping
  insurance
  warranty_reserve
  supplier_fee
  other
  payment_processing
  /// The card adjustment applied to the authoritative Bank Payment Price. NOT a
  /// cost component in the landed-cost sense — it derives a second
  /// customer-facing price from the first, so the engine must never fold it
  /// into C.
  /// RESERVED, not yet loaded by the pricing job.
  ///
  /// Kept rather than removed because Postgres cannot drop an enum value
  /// without rewriting the type, and because it remains the natural home for a
  /// question the current policy has ANSWERED but could reopen:
  ///
  ///   payment_processing (2.9% + $0.30) is still solved into the target price
  ///   by TARGET_GROSS_MARGIN_V1, and was formerly deducted from the margin
  ///   floors. docs/BANK-CARD-PRICING.md §4 now excludes card-processing
  ///   expense from those floors outright, so the double-count that worried
  ///   this note is gone. Should the owner later want a genuine bank-method
  ///   processing cost — ACH and wire are not free — it belongs here rather
  ///   than in the card uplift.
  ///
  /// Until then nothing reads it, and adding data under it would have no effect
  /// on any price — resolveInputs.server.ts loads an explicit list that does
  /// not include it.
  payment_adjustment

  @@map("cost_component_type")
}

/// §4.4 — the circularity resolution. cost_side enters the landed cost;
/// revenue_side enters the closed-form solve's denominator/numerator.
enum CostComponentBasis {
  cost_side
  revenue_side

  @@map("cost_component_basis")
}

/// §5.0/§5.2: every cost_component type supports all three kinds rather
/// than special-casing (e.g. setting is normally per_stone, but the engine
/// does not hard-code that).
enum CostComponentValueKind {
  fixed
  per_stone
  percentage

  @@map("cost_component_value_kind")
}

/// README §Pricing Profiles. Slice 1 seeds and exercises buy_now only
/// (§1 "What is NOT in this slice").
enum PricingProfileCode {
  buy_now
  group_buy
  custom
  wholesale
  friends_family
  marketplace

  @@map("pricing_profile_code")
}

/// §5.1 R8: generalises the base-plus-increment weight model to rings,
/// chains/bracelets/necklaces (length_inches) and unsized products (none).
enum SizeAxis {
  ring_size_us
  length_inches
  none

  @@map("size_axis")
}

enum MasterProductStatus {
  draft
  active
  archived

  @@map("master_product_status")
}

enum MasterVariantStatus {
  draft
  active
  archived

  @@map("master_variant_status")
}

enum PriceCalculationStatus {
  computed
  failed

  @@map("price_calculation_status")
}

/// §9.3 decideSync.
enum PriceSyncDecision {
  auto_apply
  needs_approval

  @@map("price_sync_decision")
}

/// §9.4/§7.2: terminal statuses are synced, rejected, failed, superseded —
/// the partial unique index in this migration's raw SQL depends on exactly
/// this terminal set.
enum PriceSyncIntentStatus {
  pending_approval
  approved
  rejected
  syncing
  synced
  failed
  superseded

  @@map("price_sync_intent_status")
}

/// L1 raw input (§4.0) — the PURE metal reference price per gram.
///
/// ONE price per metal, not one per karat. The cost of an alloyed piece is
/// derived: pure x fineness x grams, with fineness from the versioned registry
/// in app/domain/pricing/purity.ts.
///
/// WHY THIS REPLACED per-purity prices. Separate prices per karat drift out of
/// step silently. The seeded data showed it: 14k and 18k both implied pure gold
/// near $82.7/g while 10k implied $70.80/g — three karats, two underlying gold
/// prices, and nothing able to detect the 17% error. One reference makes that
/// unrepresentable.
///
/// Append-only and effective-dated. SEAM A (§4.7): `source` is PROVENANCE —
/// recorded and returned, never selected on. Resolution is purely "greatest
/// effectiveFrom <= asOf", so an automated feed writes source='feed' rows and
/// nothing downstream changes.
model MetalReferencePrice {
  id            String           @id @default(uuid()) @db.Uuid
  metal         Metal
  /// PURE metal, MAJOR units per gram (e.g. 82.700000 = $82.70/g of pure gold).
  /// Decimal, never float — it is multiplied by a fineness and a gram weight.
  pricePerGram  Decimal          @map("price_per_gram") @db.Decimal(18, 6)
  currency      String           @db.Char(3)
  effectiveFrom DateTime         @map("effective_from")
  source        MetalPriceSource
  /// Nullable because a feed-sourced row has no human author (§4.7 Seam A).
  enteredBy     String?          @map("entered_by")
  note          String?
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([metal, effectiveFrom])
  @@index([metal, effectiveFrom])
  @@map("metal_reference_price")
}

/// L1 raw input. Append-only. Key tuple per §4.3, including `shape` (R4)
/// and `supplierRef` (§4.7 Seam B — always null in slice 1's lookups; a
/// non-null-supplierRef row is inert until a product gains a supplier
/// dimension). CHECK (this migration's raw SQL): currency is always
/// present, and exactly one of costMinorUnits/costPerCarat is populated,
/// matching costKind.
model StoneCost {
  id             String        @id @default(uuid()) @db.Uuid
  stoneType      StoneType     @map("stone_type")
  shape          String
  caratMin       Decimal       @map("carat_min") @db.Decimal(8, 3)
  caratMax       Decimal       @map("carat_max") @db.Decimal(8, 3)
  /// Nullable qualifiers act as wildcards in the specificity ordering
  /// (§4.3). Not enums: grading vocabularies differ by stone type and are
  /// not specified as a fixed list by README/spec.
  color          String?
  clarity        String?
  cutGrade       String?       @map("cut_grade")
  labStatus      String?       @map("lab_status")
  supplierRef    String?       @map("supplier_ref")
  costKind       StoneCostKind @map("cost_kind")
  costMinorUnits BigInt?       @map("cost_minor_units")
  costPerCarat   Decimal?      @map("cost_per_carat") @db.Decimal(18, 6)
  currency       String        @db.Char(3)
  effectiveFrom  DateTime      @map("effective_from")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@unique([stoneType, shape, caratMin, caratMax, color, clarity, cutGrade, labStatus, supplierRef, effectiveFrom], name: "stone_cost_natural_key")
  @@index([stoneType, shape])
  @@map("stone_cost")
}

/// L1 raw input. Append-only. Natural key includes `valueKind` (not just
/// `componentType`) because a type such as payment_processing legitimately
/// carries two concurrently-effective rows of the same type — a
/// `percentage` rate and a `fixed` fee (§4.2, §4.6) — which the engine sums
/// separately as `r` and `f` (§5.3). CHECK (this migration's raw SQL): the
/// populated column (amount+currency vs. rate) matches valueKind.
model CostComponent {
  id               String                 @id @default(uuid()) @db.Uuid
  componentType    CostComponentType      @map("component_type")
  basis            CostComponentBasis
  valueKind        CostComponentValueKind @map("value_kind")
  amountMinorUnits BigInt?                @map("amount_minor_units")
  currency         String?                @db.Char(3)
  rate             Decimal?               @db.Decimal(9, 6)
  effectiveFrom    DateTime               @map("effective_from")
  enteredBy        String?                @map("entered_by")
  note             String?
  createdAt        DateTime               @default(now()) @map("created_at")

  @@unique([componentType, valueKind, effectiveFrom])
  @@index([componentType])
  @@map("cost_component")
}

/// L1 raw input / L4 policy row (§4.0). Append-only — a change is a new
/// version, never an edit (`@@unique([code, version])`). CHECK (this
/// migration's raw SQL): minGrossMarginRate <= targetGrossMarginRate.
/// `isPlaceholder` is a judgement-call addition beyond the literal §7.2
/// column list: D14 (§13) requires the review CLI (T8) to refuse to approve
/// an intent computed from a still-placeholder profile, which needs a
/// queryable flag rather than an inference from the (deliberately
/// nonsensical) numeric values alone.
model PricingProfile {
  id                        String             @id @default(uuid()) @db.Uuid
  code                      PricingProfileCode
  version                   Int
  /// Registry id (app/domain/pricing/solve.ts, §5.3) — a plain string, not
  /// an enum, so a new model is a registry addition, not a schema
  /// migration, matching the rounding/price-ending rule ids below.
  marginModel               String             @map("margin_model")
  /// Interpreted per `marginModel` (D14, owner-resolved 2026-09-17):
  ///   TARGET_GROSS_MARGIN_V1 -> `targetGrossMarginRate`, a fraction OF PRICE.
  ///   MARKUP_ON_COST_V1      -> `targetMarkupRate`, a fraction OF COST:
  ///                             price = cost x (1 + rate). MVP1 default 0.40.
  /// Both columns exist because a 40% markup and a 40% margin are different
  /// numbers — 40% markup on a $100 cost is $140 (a 28.6% margin), while a 40%
  /// margin on the same cost is $166.67. Conflating them in one column is how
  /// a profile silently prices ~16% low.
  targetGrossMarginRate     Decimal?           @map("target_gross_margin_rate") @db.Decimal(9, 6)
  targetMarkupRate          Decimal?           @map("target_markup_rate") @db.Decimal(9, 6)
  /// Hard safety floor, always a fraction OF PRICE regardless of margin model
  /// (R11). D14 default 0.20.
  minGrossMarginRate        Decimal            @map("min_gross_margin_rate") @db.Decimal(9, 6)
  minDollarProfitMinorUnits BigInt             @map("min_dollar_profit_minor_units")
  currency                  String             @db.Char(3)
  roundingRuleId            String             @map("rounding_rule_id")
  priceEndingRuleId         String             @map("price_ending_rule_id")
  /// D14's outstanding value. NULL means the owner has not supplied a
  /// tolerance, and automatic publication stays DISABLED — every change needs
  /// manual approval. Zero is a legitimate, different answer meaning "any
  /// change at all requires approval".
  autoApplyToleranceBps     Int?               @map("auto_apply_tolerance_bps")

  /// docs/BANK-CARD-PRICING.md, owner-locked 2026-09-18. Two prices, one
  /// underlying calculation:
  ///
  ///   AUTHORITATIVE the BANK PAYMENT PRICE (Zelle, bank transfer, designated
  ///                 ACH, wire, approved bank/manual methods). Markup,
  ///                 margin/min-profit floors, Group Buy tiers, overrides,
  ///                 recalculation and refund basis all bind this price, and
  ///                 the bank-vs-card feature never alters it.
  ///   DISPLAYED     the REGULAR/CARD PRICE, derived by a tier selected from the
  ///                 Bank Payment Price and ceilinged to the next $5. This is
  ///                 the primary advertised price and what Shopify publishes.
  ///
  /// THE PUBLISHED PRICE IS THE CARD PRICE, not price_calculation's stored
  /// price. Publishing the stored bank price would undercharge every card
  /// customer. See app/app/domain/pricing/regularCardPrice.ts.
  ///
  /// Customer-facing/legal/payment-network implementation is verified separately;
  /// it does not change the pricing-domain relationship above.
  ///
  /// Because the floors bind the Bank Payment Price — the lower of the two —
  /// both prices clear those floors by construction. Card-processing expense is
  /// not deducted from the margin/profit floors.
  ///
  /// `regularCardPriceRuleId` versions the FORMULA. `fixedCardUpliftRate` is
  /// read ONLY by the superseded CARD_UPLIFT_CEIL_WHOLE_DOLLAR_V1 rule; the
  /// current tiered rule carries its own locked table, so that changing a tier
  /// requires a new rule id rather than a data edit that would silently
  /// re-price history.
  regularCardPriceRuleId String   @map("regular_card_price_rule_id")
  fixedCardUpliftRate    Decimal  @map("fixed_card_uplift_rate") @db.Decimal(9, 6)
  effectiveFrom          DateTime @map("effective_from")
  createdBy              String   @map("created_by")
  /// See model doc comment. D14 placeholder marker.
  isPlaceholder          Boolean  @default(false) @map("is_placeholder")
  createdAt              DateTime @default(now()) @map("created_at")

  priceCalculations PriceCalculation[]
  groupBuyCampaigns GroupBuyCampaign[]

  @@unique([code, version])
  @@map("pricing_profile")
}

/// The design/cost definition Shopify's product record is joined to via
/// `shopifyProductGid` (§3 — Shopify owns the purchasable record; this is
/// ours). Mutable: not evidence, and edits here do not rewrite history
/// (history lives in price_calculation's snapshot).
model MasterProduct {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  category          String
  description       String?
  sizeAxis          SizeAxis            @map("size_axis")
  allowedSizeMin    Decimal             @map("allowed_size_min") @db.Decimal(6, 2)
  allowedSizeMax    Decimal             @map("allowed_size_max") @db.Decimal(6, 2)
  sizeIncrement     Decimal             @map("size_increment") @db.Decimal(6, 2)
  baseSize          Decimal             @map("base_size") @db.Decimal(6, 2)
  /// Explicit per R10 — product creators choose which offered metals apply.
  offeredMetals     Metal[]             @map("offered_metals")
  shopifyProductGid String?             @unique @map("shopify_product_gid")
  status            MasterProductStatus @default(draft)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  variants MasterVariant[]
  bands    RingSizeBand[]

  @@index([status])
  @@map("master_product")
}

/// A Shopify variant is metal × band (R18, §7.2). Joined to the actual
/// Shopify variant via `shopifyVariantGid` (§3 — Shopify owns the
/// purchasable record; this is the design/cost definition).
model MasterVariant {
  id                     String        @id @default(uuid()) @db.Uuid
  masterProductId        String        @map("master_product_id") @db.Uuid
  masterProduct          MasterProduct @relation(fields: [masterProductId], references: [id])
  metal                  Metal
  purity                 Purity
  bandId                 String?       @map("band_id") @db.Uuid
  band                   RingSizeBand? @relation(fields: [bandId], references: [id])
  baseWeightGrams        Decimal       @map("base_weight_grams") @db.Decimal(10, 4)
  weightPerFullSizeGrams Decimal       @map("weight_per_full_size_grams") @db.Decimal(10, 4)

  /// EXACTLY ONE per variant. Manufacturing labour is grams x the rate for
  /// this source; a piece is made in one place, so this is required rather
  /// than a list. The RATE is resolved effective-dated at calculation time and
  /// snapshotted with the calculation — only the choice of source lives here.
  laborSource                   LaborSource         @map("labor_source")
  minBankPaymentPriceMinorUnits BigInt?             @map("min_bank_payment_price_minor_units")
  minBankPaymentPriceCurrency   String?             @map("min_bank_payment_price_currency") @db.Char(3)
  shopifyVariantGid             String?             @unique @map("shopify_variant_gid")
  /// R17 (owner ruling, 2026-09-20) — the mapping the `inventory_levels/update`
  /// webhook resolves through. Populated from the Admin API's
  /// `InventoryItem.id` (via `ProductVariant.inventoryItem.id`, never the
  /// deprecated singular `InventoryItem.variant` field — see
  /// `backfillInventoryItemGids.server.ts`). NULLABLE and requires an
  /// explicit BACKFILL for every already-linked variant before the webhook
  /// is relied on: an unpopulated mapping resolves nothing and looks
  /// identical to the handler correctly finding no match, which is exactly
  /// what cost the live-verification session real time before R15/R17's
  /// root cause was found.
  shopifyInventoryItemGid       String?             @unique @map("shopify_inventory_item_gid")
  /// Slice 2 M1 (owner §7.3). Per-variant escape hatch from the Bank Payment
  /// Discount: a bank-mode cart still charges an ineligible line the Regular/
  /// Card Price (owner §7.4, criterion 41). Defaults ON — most variants are
  /// eligible, and the flag exists to turn a specific one OFF, not the other
  /// way round. This is the SYSTEM OF RECORD (criterion 40); Shopify's own
  /// metafield mirror of it is presentation cache only.
  bankPaymentDiscountEligible   Boolean             @default(true) @map("bank_payment_discount_eligible")
  /// Slice 3, M11 (docs/specs/SLICE-3-LUXURY-STEALS.md, D27, criteria
  /// 125-128, 146-150). THE authoritative Luxury Steal assignment — variant
  /// grain, not product grain (D27 supersedes D26's product-level wording).
  /// A product-level `is_luxury_steal` column existed briefly from slice 1
  /// and was retired by the migration that added this column's backfill —
  /// see that migration's own header comment; nothing has read the product
  /// grain since. Set only through the controlled admin path in
  /// `app/db/repositories/luxuryStealRepository.server.ts`. Nothing may
  /// derive this from a Shopify tag, collection membership, or the
  /// `carat.luxury_steal` metafield — the metafield is a presentation cache
  /// synced FROM this column (task 3-2), never the reverse, and a stale or
  /// missing cache must fail safe by falling back to THIS column (criterion
  /// 127/150). Default false: most variants are ordinary Buy Now stock.
  isLuxurySteal                 Boolean             @default(false) @map("is_luxury_steal")
  status                        MasterVariantStatus @default(draft)
  /// Compare-and-set anchor for slice 2's sync (§9.4): the sync executes
  /// only if the intent's priceCalculationId is still the newest computed
  /// calculation for this variant.
  lastSyncedPriceCalculationId  String?             @unique @map("last_synced_price_calculation_id") @db.Uuid
  lastSyncedPriceCalculation    PriceCalculation?   @relation("LastSyncedCalculation", fields: [lastSyncedPriceCalculationId], references: [id])
  createdAt                     DateTime            @default(now()) @map("created_at")
  updatedAt                     DateTime            @updatedAt @map("updated_at")

  weightOverrides          VariantWeightOverride[]
  stones                   MasterVariantStone[]
  priceCalculations        PriceCalculation[]        @relation("VariantCalculations")
  syncIntents              PriceSyncIntent[]
  priceOverrides           PriceOverride[]
  groupBuyCampaignVariants GroupBuyCampaignVariant[]
  groupBuyUnitEvents       GroupBuyUnitEvent[]
  groupBuyRefunds          GroupBuyRefund[]
  priceSyncFailures        PriceSyncFailure[]
  priceCalculationFailures PriceCalculationFailure[]
  bankPaymentOrderLines    BankPaymentOrderLine[]
  adminAlertNotifications  AdminAlertNotification[]
  luxuryStealSyncFailures  LuxuryStealSyncFailure[]
  warrantyClaims           WarrantyClaim[]
  rmaRequests              RmaRequest[]

  @@unique([masterProductId, metal, purity, bandId])
  @@index([status])
  /// Slice 3 M11: the collection query (which variants are Luxury Steals,
  /// for badge/merchandising reads) and the order-time check (criterion 150)
  /// both filter on this column directly.
  @@index([isLuxurySteal])
  @@map("master_variant")
}

/// Per-product configurable bands (R9), seeded with the 2–6 / 6.5–8 / 8.5–11
/// defaults but not hard-coded. Gapless/non-overlapping coverage is
/// validated at write time by the repository layer (T5), not by a DB
/// constraint — criterion 12.
model RingSizeBand {
  id              String        @id @default(uuid()) @db.Uuid
  masterProductId String        @map("master_product_id") @db.Uuid
  masterProduct   MasterProduct @relation(fields: [masterProductId], references: [id])
  label           String
  sizeMin         Decimal       @map("size_min") @db.Decimal(6, 2)
  sizeMax         Decimal       @map("size_max") @db.Decimal(6, 2)
  sortOrder       Int           @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")

  variants MasterVariant[]

  @@index([masterProductId])
  @@map("ring_size_band")
}

/// Exact finished-weight override (R8) — wins unconditionally over the
/// linear model at the given size.
model VariantWeightOverride {
  id              String        @id @default(uuid()) @db.Uuid
  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])
  size            Decimal       @db.Decimal(6, 2)
  weightGrams     Decimal       @map("weight_grams") @db.Decimal(10, 4)
  reason          String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([masterVariantId, size])
  @@map("variant_weight_override")
}

/// The stone composition the engine sums in §5.2 step 3. `position`
/// distinguishes multiple stones of the same spec on one variant (e.g. two
/// side stones) without relying on row order.
model MasterVariantStone {
  id              String        @id @default(uuid()) @db.Uuid
  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])
  position        Int
  stoneType       StoneType     @map("stone_type")
  shape           String
  carat           Decimal       @db.Decimal(8, 3)
  color           String?
  clarity         String?
  cutGrade        String?       @map("cut_grade")
  labStatus       String?       @map("lab_status")
  quantity        Int
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([masterVariantId, position])
  @@map("master_variant_stone")
}

/// L6 immutable pricing record (§5.6, §6). Append-only — see this
/// migration's trigger extension. `@@unique([runId, masterVariantId])` is
/// what makes re-running a job idempotent (§9.4, criterion 23): a repeat of
/// the same runId is a no-op, not a duplicate row. F-7 caveat (recorded per
/// §6): enforcement depends on the slice-2 deploy task splitting the
/// migration role from the runtime role — until then, the runtime role
/// could DROP TRIGGER and this is documentation, not a guarantee.
/// D15. What caused a recalculation run. Recorded because "the price changed"
/// and "a staff member changed the price" are different facts in an audit, and
/// a dispute six months later cannot distinguish them after the fact.
enum PriceRecalculationTrigger {
  /// The platform scheduler (R21). Daily by default; the cadence is scheduler
  /// configuration, not code.
  scheduled
  /// A staff member asked for an immediate run rather than waiting for the
  /// next scheduled one (D15).
  staff
  /// Entry of a new metal reference price, which makes every dependent price
  /// stale immediately (D15). Superseded in intent by `input_change` below,
  /// which generalises this to every price-affecting input rather than only
  /// metal prices, but kept rather than removed: it is load-bearing on every
  /// PriceRecalculationRun row already written under it, and Postgres cannot
  /// drop an enum value without rewriting the type.
  metal_price_entry
  /// Slice 2 stage 2A, M4 (docs/specs/SLICE-2-BUY-NOW-STOREFRONT-AND-SYNC.md
  /// §6, owner §3.1, criteria 17-19). Any persisted change to a
  /// price-affecting input -- not only a metal price -- triggers an
  /// immediate recalculation. A run with this trigger always carries a
  /// `pricingInputChangeId` (see the CHECK on price_recalculation_run added
  /// in the M4 migration), which is also the grouping key that lets the
  /// resulting intents be bulk-approved as one unit (criterion 11).
  input_change

  @@map("price_recalculation_trigger")
}

/// Slice 2 stage 2A, M3 (docs/specs/SLICE-2-BUY-NOW-STOREFRONT-AND-SYNC.md §6,
/// owner §3.1). WHICH category of price-affecting input changed, matching the
/// input inventory in docs/specs/SLICE-1-PRICING.md §4.2 plus the
/// design-definition tables §7.2 lists that also feed the engine (product/
/// variant sizing and weight, ring-size bands, stone composition). `manual`
/// is the staff-initiated catch-all for "recompute now" with no single
/// input row behind it -- the input-change analogue of
/// `PriceRecalculationTrigger.staff`.
///
/// A fixed list, like every other `*_kind`/`*_type` enum in this file:
/// extending it is an additive migration, not a data edit, so a stored
/// `pricing_input_change` row always names a real, reviewable category.
enum PricingInputChangeKind {
  metal_reference_price
  stone_cost
  cost_component
  labor_rate
  pricing_profile
  ring_size_band
  variant_weight_override
  master_variant_stone
  master_variant
  master_product
  manual

  @@map("pricing_input_change_kind")
}

/// Slice 2 stage 2A, M3. Append-only -- see migration
/// 20260919085402_pricing_input_change_and_bank_payment_line_append_only for
/// the enforcing trigger -- the owner's immediate-recalculation trigger
/// record (§3.1) AND
/// the grouping key criterion 11's bulk approval resolves a set of intents
/// from: every `price_recalculation_run` sharing one `pricingInputChangeId`
/// was caused by the SAME underlying edit (e.g. one metal price entry), so
/// every `price_sync_intent` descending from those runs can be approved in
/// one action.
///
/// `entityId` is deliberately a plain string, not a typed/`@db.Uuid` foreign
/// key, and carries no Prisma relation -- it is POLYMORPHIC (the row it
/// names lives in whichever table `kind` names), which Prisma cannot express
/// as a single relation. Same shape as `AuditEvent.entityId` for the same
/// reason.
model PricingInputChange {
  id        String                 @id @default(uuid()) @db.Uuid
  kind      PricingInputChangeKind
  /// The id of the specific row that changed, in the table `kind` names.
  /// Nullable: a `manual` recalculation names no single input row.
  entityId  String?                @map("entity_id")
  /// Nullable: a feed-sourced input change (Slice 1 §4.7 Seam A) has no
  /// human author, matching `MetalReferencePrice.enteredBy`.
  changedBy String?                @map("changed_by")
  /// When the underlying input actually changed (e.g. the new row's
  /// `effective_from`), which is not necessarily "now" -- distinct from
  /// `createdAt`, when THIS record was written.
  changedAt DateTime               @map("changed_at") @db.Timestamptz(6)
  note      String?
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  recalculationRuns PriceRecalculationRun[]

  @@index([kind, changedAt])
  @@map("pricing_input_change")
}

/// D15 run-level audit record. PriceCalculation already carries the per-variant
/// facts; this carries the facts that belong to the RUN — what triggered it,
/// who asked for it, and what it did overall.
///
/// Append-only like the rest of the pricing history: a run record is written
/// once at the start and completed once at the end, and is never rewritten.
model PriceRecalculationRun {
  id          String                    @id @db.Uuid
  trigger     PriceRecalculationTrigger
  /// Actor for a staff-triggered run. NULL for a scheduled run, where there is
  /// no human to name and inventing one would be false attribution.
  triggeredBy String?                   @map("triggered_by")
  /// Free-text justification a staff member supplies for an off-schedule run.
  reason      String?
  /// The as-of instant the run resolved its inputs at (§5.6 reproducibility).
  asOf        DateTime                  @map("as_of") @db.Timestamptz(6)
  startedAt   DateTime                  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?                 @map("finished_at") @db.Timestamptz(6)

  /// Slice 2 stage 2A, M4. Set exactly when `trigger = input_change` (CHECK
  /// added by that migration) -- the record of WHICH persisted input edit
  /// caused this run, and the join criterion 11's bulk approval uses to group
  /// the resulting intents. Unlike `PriceCalculation.runId` (a plain
  /// correlating UUID with no Prisma relation, matching that model's existing
  /// convention), this is a genuine FK: pricing_input_change is a fixed,
  /// pre-existing row a run always points at, not a self-generated id a run
  /// invents.
  pricingInputChangeId String?             @map("pricing_input_change_id") @db.Uuid
  pricingInputChange   PricingInputChange? @relation(fields: [pricingInputChangeId], references: [id])

  computed      Int @default(0)
  skipped       Int @default(0)
  failed        Int @default(0)
  autoApply     Int @default(0) @map("auto_apply")
  needsApproval Int @default(0) @map("needs_approval")
  unchanged     Int @default(0)

  @@index([trigger, startedAt])
  @@map("price_recalculation_run")
}

/// D14 (owner-directed 2026-09-17): "manual owner overrides are permitted even
/// when they violate the floors, subject to warning, confirmation, reason and
/// audit". This table IS that audit.
///
/// Append-only. An override is a deliberate departure from the calculated
/// price, and the record of who made it, what they were warned about and why
/// is the whole point — a mutable override row would defeat it.
///
/// The override does NOT edit any price_calculation. The calculated price
/// remains on the record exactly as computed; this sits alongside it. That
/// separation is what lets "what did the engine say?" and "what did we
/// actually charge?" both be answered later.
/// D14 / architect follow-up N3. An override history is append-only, so
/// "this override replaces the previous one" and "go back to the calculated
/// price" both have to be expressed by APPENDING a row rather than by editing
/// or deleting one.
enum PriceOverrideKind {
  /// Sets a manual price, superseding any override currently in effect.
  set
  /// Returns the variant to its calculated price. Carries no price of its own.
  revoke
  /// Slice 2 T3 (owner §2.4, criterion 15). A SYSTEM-detected retirement: the
  /// next MATERIAL recalculation after this override was set (§13.1 of the
  /// slice 2 spec -- materiality means the recalculation produced a
  /// DIFFERENT Bank Payment Price) retires it automatically, unless
  /// `neverExpire` is set. Distinct from `revoke` because "the system
  /// noticed the price moved" and "a human explicitly reverted this" are
  /// different facts for an audit. Carries no price of its own, exactly like
  /// `revoke`.
  expired

  @@map("price_override_kind")
}

model PriceOverride {
  id              String        @id @default(uuid()) @db.Uuid
  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])

  /// MEANS TWO DIFFERENT THINGS DEPENDING ON `kind` — read this before
  /// querying or joining on it.
  ///
  ///   kind = set     -> the calculation this override DEPARTS FROM: the
  ///                      engine's answer a human is choosing to override,
  ///                      evaluated at the time the override was written.
  ///   kind = expired  -> the calculation whose DIFFERING price CAUSED the
  ///                      automatic expiry (owner §2.4; spec criteria 15/16;
  ///                      app/app/domain/pricing/overrideExpiry.ts). This is
  ///                      the NEW calculation the recalculation just
  ///                      produced, not a copy of the retired override's own
  ///                      reference.
  ///   kind = revoke   -> carries forward the SAME calculation the revoked
  ///                      override departed from (no new calculation caused
  ///                      a revoke; a human decision did). See
  ///                      revokePriceOverride in
  ///                      app/app/jobs/pricing/priceOverride.server.ts.
  ///
  /// The asymmetry between `expired` and `revoke` is deliberate and correct:
  /// an expiry has a genuine causal calculation worth naming (the delta is
  /// then reconstructible from this row plus the one it supersedes); a
  /// revoke does not. Both are legitimate; the point of this comment is that
  /// a reader — including one reading this in a dispute years from now —
  /// must check `kind` before interpreting what this column names.
  priceCalculationId String?           @map("price_calculation_id") @db.Uuid
  priceCalculation   PriceCalculation? @relation(fields: [priceCalculationId], references: [id])

  kind PriceOverrideKind @default(set)

  /// The override this one replaces, forming a single chain per variant. NULL
  /// on the first override for a variant. A partial unique index stops two rows
  /// superseding the same predecessor, which would fork the history and make
  /// "the override in effect" ambiguous.
  supersedesId String?        @unique @map("supersedes_id") @db.Uuid
  supersedes   PriceOverride? @relation("PriceOverrideChain", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supersededBy PriceOverride? @relation("PriceOverrideChain")

  /// NULL exactly when kind is `revoke` or `expired` — neither carries a price
  /// of its own; both mean "the calculated price applies again". Enforced by a
  /// CHECK, so the two fields cannot disagree.
  /// An override sets the BANK PAYMENT price. The floors that warn about it are
  /// measured on it, and the advertised card price is re-derived from it.
  overrideBankPaymentPriceMinorUnits BigInt? @map("override_bank_payment_price_minor_units")
  currency                           String  @db.Char(3)

  /// Slice 2 T3 (owner §2.4, criterion 16). When true, this override chain is
  /// exempt from automatic expiry on a material recalculation and is retired
  /// only by an explicit human `revoke`. Meaningful on the CURRENT (not-yet-
  /// superseded) row of a chain only -- T3's expiry job reads it there.
  neverExpire Boolean @default(false) @map("never_expire")

  /// Which floors the override breaches, if any. An EMPTY array is meaningful:
  /// it records that the system checked and found none, as distinct from never
  /// having checked.
  breachedFloors Json @map("breached_floors")

  /// The exact warning text shown to the operator. Stored verbatim rather than
  /// regenerated later: what they were actually told is the fact that matters,
  /// and the wording may change in a future release.
  warningShown String? @map("warning_shown")

  /// Required, always. An override without a stated reason is indistinguishable
  /// from a mistake.
  reason       String
  overriddenBy String @map("overridden_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([masterVariantId, createdAt])
  @@map("price_override")
}

model PriceCalculation {
  id                         String                 @id @default(uuid()) @db.Uuid
  runId                      String                 @map("run_id") @db.Uuid
  masterVariantId            String                 @map("master_variant_id") @db.Uuid
  masterVariant              MasterVariant          @relation("VariantCalculations", fields: [masterVariantId], references: [id])
  pricingProfileId           String                 @map("pricing_profile_id") @db.Uuid
  pricingProfile             PricingProfile         @relation(fields: [pricingProfileId], references: [id])
  profileVersion             Int                    @map("profile_version")
  engineVersion              String                 @map("engine_version")
  roundingRuleId             String                 @map("rounding_rule_id")
  priceEndingRuleId          String                 @map("price_ending_rule_id")
  asOf                       DateTime               @map("as_of")
  snapshotId                 String                 @map("snapshot_id") @db.Uuid
  snapshot                   Snapshot               @relation(fields: [snapshotId], references: [id])
  costBasisSize              Decimal?               @map("cost_basis_size") @db.Decimal(6, 2)
  landedCostMinorUnits       BigInt                 @map("landed_cost_minor_units")
  /// The BANK PAYMENT PRICE: the number the 40% markup, the 20% margin floor
  /// and the $100 profit floor were all measured on, and the price a customer
  /// pays by an eligible bank method.
  ///
  /// The Regular/Card Price is derived from it by the versioned rule recorded
  /// on the pricing profile, and is deliberately NOT stored a second time —
  /// one price, one source of truth, no possibility of the pair disagreeing.
  bankPaymentPriceMinorUnits BigInt                 @map("bank_payment_price_minor_units")
  currency                   String                 @db.Char(3)
  status                     PriceCalculationStatus
  failureReason              String?                @map("failure_reason")
  createdAt                  DateTime               @default(now()) @map("created_at")

  syncIntents           PriceSyncIntent[]
  lastSyncedByVariant   MasterVariant?         @relation("LastSyncedCalculation")
  priceOverrides        PriceOverride[]
  bankPaymentOrderLines BankPaymentOrderLine[]

  @@unique([runId, masterVariantId])
  @@index([masterVariantId, createdAt])
  @@index([status])
  @@map("price_calculation")
}

/// Mutable review/sync state machine (§7.2, §9.3, §9.4) — deliberately NOT
/// append-only; this is what the architect ruling in §7.2 splits away from
/// the immutable price_calculation. Partial unique index (this migration's
/// raw SQL, Prisma cannot express it): at most one non-terminal intent
/// (status NOT IN synced/rejected/failed/superseded) per masterVariantId.
model PriceSyncIntent {
  id                                 String                @id @default(uuid()) @db.Uuid
  masterVariantId                    String                @map("master_variant_id") @db.Uuid
  masterVariant                      MasterVariant         @relation(fields: [masterVariantId], references: [id])
  priceCalculationId                 String                @map("price_calculation_id") @db.Uuid
  priceCalculation                   PriceCalculation      @relation(fields: [priceCalculationId], references: [id])
  decision                           PriceSyncDecision
  status                             PriceSyncIntentStatus
  previousBankPaymentPriceMinorUnits BigInt?               @map("previous_bank_payment_price_minor_units")
  previousBankPaymentPriceCurrency   String?               @map("previous_bank_payment_price_currency") @db.Char(3)
  deltaBps                           Int?                  @map("delta_bps")
  /// D15 requires the DOLLAR change alongside the percentage one. Stored
  /// rather than derived so the audit row is self-contained: the previous price
  /// can be superseded later, but this record of what changed stays intact.
  deltaMinorUnits                    BigInt?               @map("delta_minor_units")
  decidedBy                          String?               @map("decided_by")
  decidedAt                          DateTime?             @map("decided_at")
  reason                             String?
  syncedAt                           DateTime?             @map("synced_at")
  shopifyVariantGid                  String?               @map("shopify_variant_gid")
  attemptCount                       Int                   @default(0) @map("attempt_count")
  createdAt                          DateTime              @default(now()) @map("created_at")
  updatedAt                          DateTime              @updatedAt @map("updated_at")

  @@index([masterVariantId])
  @@index([status])
  @@map("price_sync_intent")
}

/// Persistent admin alert state for a sync-failure episode (owner §4.3): it
/// does not auto-clear. `active` throughout the episode; `cleared` when a
/// later sync SUCCEEDS (criterion 22/25 -- also what drives auto-restore of a
/// suspended variant); `dismissed` when a human silences it with a reason
/// (criterion 22) WITHOUT the underlying sync necessarily having succeeded.
/// Deliberately kept distinct from `cleared`: silencing the alert is not the
/// same fact as the price being live and correct again, and a suspended
/// variant (criterion 24) must not be read as un-suspended merely because
/// staff stopped being notified about it.
enum PriceSyncFailureAlertState {
  active
  cleared
  dismissed

  @@map("price_sync_failure_alert_state")
}

/// Slice 2 stage 2A, M5 (docs/specs/SLICE-2-BUY-NOW-STOREFRONT-AND-SYNC.md
/// §6, owner §4). One row per FAILURE EPISODE for a variant, not per sync
/// attempt -- `attemptCount`/`lastAttemptAt`/`lastError` accumulate across
/// retries. THIS IS WHY IT IS A SEPARATE TABLE FROM price_sync_intent: the
/// 48-hour timer (criterion 23) anchors on `firstFailedAt`, the moment of the
/// FIRST failure, and retries span multiple intents -- a column on the
/// intent would reset the clock every retry instead of running from the
/// original failure.
///
/// DELIBERATELY MUTABLE (like `price_sync_intent`, unlike the evidence
/// tables): `attemptCount`, `lastAttemptAt`, `lastError`, `alertState`,
/// `suspendedAt` and the dismiss/resolve columns are all updated as the
/// episode progresses. An episode CLOSES by setting `resolvedAt` (a later
/// sync succeeded); a subsequent new failure for the same variant starts a
/// FRESH row rather than reopening this one, which is what the partial
/// unique index below enforces.
///
/// `suspendedAt`, once set, is retained as history even after the episode
/// resolves — "is this variant suspended right now" is answered by the
/// application as "does the variant's OPEN (resolvedAt IS NULL) failure row
/// have suspendedAt set", per criterion 25's auto-restore.
///
/// `dismissedBy`/`dismissedReason`/`dismissedAt` are a judgement-call
/// addition beyond the spec's literal M5 column list: owner §4.3 requires a
/// human dismissal to carry "a reason", and this repository's established
/// convention for every other attributed override/exception (price_override,
/// group_buy_campaign's unsafe override, group_buy_refund's override) is
/// actor + reason + timestamp, never a bare boolean. Flagged here for
/// architect review rather than silently added.
model PriceSyncFailure {
  id              String        @id @default(uuid()) @db.Uuid
  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])

  firstFailedAt DateTime @map("first_failed_at") @db.Timestamptz(6)
  lastAttemptAt DateTime @map("last_attempt_at") @db.Timestamptz(6)
  attemptCount  Int      @default(1) @map("attempt_count")
  lastError     String   @map("last_error")

  alertState PriceSyncFailureAlertState @default(active) @map("alert_state")

  /// Set when the 48-hour timer (criterion 23/24) expires unresolved. Never
  /// cleared back to NULL -- see the model doc comment.
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(6)

  /// A human silenced the persistent alert (criterion 22). Does NOT by
  /// itself resolve the episode or restore a suspended variant -- see the
  /// enum doc comment.
  dismissedBy     String?   @map("dismissed_by")
  dismissedReason String?   @map("dismissed_reason")
  dismissedAt     DateTime? @map("dismissed_at") @db.Timestamptz(6)

  /// A later sync succeeded. Closes the episode, clears the alert and is
  /// what criterion 25's auto-restore reads (no human action).
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// At most one OPEN episode per variant (partial unique index, this
  /// migration's raw SQL -- Prisma cannot express it), mirroring
  /// price_sync_intent_one_non_terminal_per_variant.
  @@index([masterVariantId])
  @@index([alertState])
  @@map("price_sync_failure")
}

/// Slice 2 stage 2A follow-on (docs/SLICE-2-AND-GROUP-BUY-OWNER-DECISIONS.md
/// §7; sibling migration to M5's price_sync_failure). One row per FAILURE
/// EPISODE for a variant's price RECALCULATION -- never per sync attempt.
///
/// DELIBERATELY A SEPARATE TABLE FROM price_sync_failure (owner ruled the two
/// failure modes stay conceptually separate; see §16.5 R2's neighbouring
/// ruling). A sync failure means a price WAS computed and Shopify refused it;
/// this means no price could be computed AT ALL -- an unresolved ring-size
/// band, a missing stone cost, an invalid weight, absent labour/metal inputs,
/// a currency mismatch, or an unavailable pricing rule/profile (owner §7's own
/// examples). The remedies rhyme (keep the last valid price live, 48-hour
/// unresolved timer anchored on the FIRST failure, automatic no-human-action
/// restore) but the causes and the admin diagnosis differ, which is exactly
/// what `failureType` exists to answer and price_sync_failure has no
/// equivalent of.
///
/// NO DISMISSIBLE ALERT. price_sync_failure's alert_state (active / cleared /
/// dismissed) exists because owner §4/§15 describes a PERSISTENT alert a
/// human can silence. Owner §7 describes only an immediate one-time
/// notification on the first failure -- there is nothing here for R2's
/// dismiss-vs-resolve split to apply to, so this table carries no alert_state
/// and no dismissed_* columns at all.
model PriceCalculationFailure {
  id              String        @id @default(uuid()) @db.Uuid
  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])

  firstFailedAt DateTime @map("first_failed_at") @db.Timestamptz(6)
  lastAttemptAt DateTime @map("last_attempt_at") @db.Timestamptz(6)
  attemptCount  Int      @default(1) @map("attempt_count")

  /// WHAT is unresolvable, not merely that something is -- see
  /// PriceCalculationFailureType's own doc comment.
  failureType PriceCalculationFailureType @map("failure_type")
  lastError   String                      @map("last_error")

  /// Set when the 48-hour timer (owner §7) expires unresolved. Never cleared
  /// back to NULL -- mirrors price_sync_failure's R4 (suspendedAt is history,
  /// not current state; resolvedAt is what current availability reads).
  suspendedAt DateTime? @map("suspended_at") @db.Timestamptz(6)

  /// A later recalculation succeeded. Closes the episode and is what
  /// automatic no-human-action restoration (owner §7 recovery step 3) reads.
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  /// Owner §7 recovery step 5: "record the resolution timestamp and
  /// trigger/actor." "scheduled" for the routine recalculation run that
  /// discovers the fix, or a staff identifier for a manually triggered one.
  /// price_sync_failure has no equivalent column: a sync's resolution is
  /// always "a later sync succeeded" and names no separate trigger, while a
  /// calculation can be corrected by either a routine run or a deliberate
  /// staff action and owner §7 requires telling those apart.
  resolvedTrigger String?   @map("resolved_trigger")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// At most one OPEN episode per variant (partial unique index, this
  /// migration's raw SQL -- Prisma cannot express it), mirroring
  /// price_sync_failure_one_open_per_variant.
  @@index([masterVariantId])
  @@index([failureType])
  @@map("price_calculation_failure")
}

/// The calculation-failure cause taxonomy (owner §7's own examples).
/// Deliberately NOT shaped like price_sync_failure_alert_state, which names
/// an ALERT'S state rather than a CAUSE: a sync failure has one cause
/// (Shopify refused the write) and several possible alert states, while a
/// calculation failure has one notification behaviour (notify once,
/// immediately) and several possible causes. `unknown` is a real, storable
/// value -- see classifyCalculationFailureType in
/// app/domain/pricing/calculationFailure.ts -- rather than a default that
/// would let an unrecognised error masquerade as a classified one.
enum PriceCalculationFailureType {
  unresolved_band
  invalid_size
  invalid_weight
  missing_cost_input
  ambiguous_cost_input
  currency_mismatch
  margin_unreachable
  unknown

  @@map("price_calculation_failure_type")
}

// =============================================================================
// admin_alert_notification -- Slice 2 stage 2A (owner §7/§15; T5 sibling
// note: keep this table beside, not merged into, price_sync_failure /
// price_calculation_failure). Both failure episodes already know they are
// wrong; this table only answers "has a human been told, and how."
//
// ONE ROW PER (episode, meaningful transition), never per retry. The
// UNIQUE constraint below is the dedup mechanism itself -- an insert that
// collides with an already-notified transition is the intended, expected
// outcome of a retried job step, not an error condition (see
// `adminAlertDispatch.server.ts`, which relies on catching that collision
// rather than checking first: a read-then-write check races under
// concurrent callers exactly like idempotency_key and webhook_event's own
// unique constraints do).
// =============================================================================

/// Distinguishes which failure table this notification is ABOUT. Not a
/// foreign key to either `price_calculation_failure`, `price_sync_failure`
/// or `bank_payment_order` directly -- `sourceId` cannot carry a single FK
/// to three different tables, so this column plus `sourceId` together are
/// the polymorphic reference, resolved by the reading side.
///
/// `bank_payment_guarantee` added Slice 2C-b (spec §13/§14, criterion 102;
/// `docs/specs/SLICE-2C-BANK-PAYMENT-CHECKOUT.md`) -- a variant the 24-hour
/// guarantee sweep cannot price because its published Bank Payment Price is
/// currently unresolvable (D21). `sourceId` here is the FAILURE EPISODE's
/// own id -- `price_calculation_failure.id` or `price_sync_failure.id`,
/// whichever made the variant unresolvable -- the SAME semantics the other
/// two members already use, deliberately NOT `bank_payment_order.id`.
///
/// A bank order is disposable (open, then cancelled or completed); the
/// episode is the thing with real opened/resolved history. Keying on the
/// order instead would let one flag-then-resolve cycle permanently block a
/// LATER, unrelated episode from ever alerting again for that same order --
/// the unique index below allows exactly one `opened` and one `resolved`
/// per id, for the life of that id. Keying on the episode also means a
/// single unresolvable variant can correctly block SEVERAL bank orders at
/// once: `app/jobs/bankpayment/guaranteeSweep.server.ts` aggregates every
/// affected order per episode and raises ONE alert naming all of them,
/// rather than one alert per order repeating the same underlying cause.
///
/// Added in migration 20260922032504_admin_alert_source_kind_bank_payment_
/// guarantee. `ALTER TYPE ... ADD VALUE` cannot be compared against in the
/// same transaction it is added in (Postgres restriction; this repository's
/// own precedent is 20260917070507 and 20260919084408, both split for that
/// reason) -- but THIS addition needs no follow-up migration at all, since
/// nothing else in this schema change references the new value at the SQL
/// level; it is written only by application-level `INSERT`s, in a later,
/// separate transaction. See that migration's own header comment.
enum AdminAlertSourceKind {
  calculation_failure
  sync_failure
  bank_payment_guarantee

  @@map("admin_alert_source_kind")
}

/// The closed set of meaningful state changes a failure episode's
/// notification fires on (team-lead directive): episode opened, the 48-hour
/// suspension reached, and resolved. Deliberately NOT "retry" -- a retry is
/// not a state change a human needs telling about again.
enum AdminAlertEvent {
  opened
  suspended
  resolved

  @@map("admin_alert_event")
}

/// Honest-by-construction delivery accounting. `sent` requires a real
/// provider message id; `skipped_unconfigured` requires a stated reason
/// (missing env var); `failed` requires the provider/network failure name.
/// There is no state meaning "an email was sent" without one of these three
/// being true -- see the module doc comment above for why that matters.
enum AdminAlertEmailDeliveryStatus {
  sent
  skipped_unconfigured
  failed

  @@map("admin_alert_email_delivery_status")
}

model AdminAlertNotification {
  id         String               @id @default(uuid()) @db.Uuid
  sourceKind AdminAlertSourceKind @map("source_kind")
  /// The failure episode's own id -- `price_calculation_failure.id` or
  /// `price_sync_failure.id`, per `sourceKind` -- for EVERY member,
  /// including `bank_payment_guarantee` (see that member's own doc comment
  /// for why it is the episode, never `bank_payment_order.id`). Not a DB
  /// foreign key -- see the enum doc comment above.
  sourceId   String               @map("source_id") @db.Uuid
  event      AdminAlertEvent

  /// Denormalized from the episode row for admin listing/filtering without
  /// a second join back through `sourceId` -- both failure tables already
  /// carry this column, so it is never ambiguous which variant a
  /// notification is about.
  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])

  emailDeliveryStatus    AdminAlertEmailDeliveryStatus @map("email_delivery_status")
  /// Populated for `skipped_unconfigured` (which env var(s) were missing) and
  /// `failed` (the provider/network error's name, never its raw body --
  /// see the dispatch module's own discipline). NULL only for `sent`.
  emailDeliveryReason    String?                       @map("email_delivery_reason")
  /// The provider's own message id. Populated only for `sent` -- proof the
  /// provider actually accepted the send, not merely that this code
  /// attempted one.
  emailProviderMessageId String?                       @map("email_provider_message_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// THE DEDUP. At most one notification row per (episode, transition) --
  /// see the module doc comment above.
  @@unique([sourceKind, sourceId, event])
  @@index([masterVariantId])
  @@map("admin_alert_notification")
}

enum BankPaymentOrderStatus {
  /// Quoted, awaiting payment. The order's normal resting state (owner
  /// §8.2): unpaid with an unchanged price is not an error.
  open
  /// Unpaid at 24h with ANY line price changed (owner §8.3, criterion 46), or
  /// cancelled for another reason recorded in `cancellationReason`.
  cancelled
  /// Payment verified and the draft converted to a real Shopify order
  /// (criterion 51). Terminal.
  completed

  @@map("bank_payment_order_status")
}

/// Phase 2C-c, verification admin surface (spec §5.4 criteria 87/23;
/// `CLAUDE.md` #14). EXACTLY the four electronic methods the owner locked as
/// eligible Bank Payment methods -- no cheque, money order or other paper
/// instrument. This is an enum rather than free text on
/// `BankPaymentOrder.verifiedPaymentMethod` precisely so a staff member
/// cannot type "check" into a field and have it silently recorded as a valid
/// verification: the database itself is the enforcement, not code review.
enum BankPaymentMethod {
  zelle
  ach
  bank_transfer
  wire

  @@map("bank_payment_method")
}

/// The 24-hour guarantee sweep's CUSTOMER cancellation email delivery record
/// (spec §13/§14; owner verification list). Same member names as
/// `AdminAlertEmailDeliveryStatus` on purpose (both describe a real email
/// send's three possible outcomes), but kept as a SEPARATE type -- see
/// `BankPaymentOrder.cancellationEmailStatus`'s own doc comment for why
/// coupling the customer-email record to the admin-alert one would be a
/// false relationship.
enum BankPaymentCancellationEmailStatus {
  sent
  skipped_unconfigured
  failed

  @@map("bank_payment_cancellation_email_status")
}

/// Slice 2 stage 2C, M6 (docs/specs/SLICE-2-BUY-NOW-STOREFRONT-AND-SYNC.md §6,
/// owner §8). The header/order-level record: one Shopify draft order, one
/// 24-hour price guarantee, one manual payment verification, one eventual
/// completed Shopify order. Per-line quotes live on `BankPaymentOrderLine`.
///
/// DELIBERATELY MUTABLE: status advances open -> cancelled | completed, and
/// the verification/completion/cancellation blocks are populated as the
/// lifecycle proceeds. `BankPaymentOrderLine`'s quote columns are what stays
/// append-only (see the M7 migration) -- this header row is the workflow
/// state machine layered on top of those frozen facts, the same architecture
/// as `PriceSyncIntent` sitting atop the immutable `PriceCalculation`.
///
/// `completedAt`/`shopifyOrderGid` and `cancelledAt`/`cancellationReason` are
/// judgement-call additions beyond the spec's literal M6 column list,
/// structurally required to express criterion 46 (an attributed cancellation)
/// and criterion 51 (completion names a REAL Shopify order distinct from the
/// draft order it came from) -- flagged for architect review.
model BankPaymentOrder {
  id                   String                 @id @default(uuid()) @db.Uuid
  shopifyDraftOrderGid String                 @unique @map("shopify_draft_order_gid")
  status               BankPaymentOrderStatus @default(open)

  /// Slice 2C, M8 (docs/specs/SLICE-2C-BANK-PAYMENT-CHECKOUT.md §6, criteria
  /// 97-98). THE ONE STORED EXCEPTION to "do not duplicate what Shopify
  /// already holds on the draft order" -- the shipping address is sent to
  /// Shopify at draft-order creation and deliberately NOT persisted here
  /// (criterion 99: read it back from Shopify when something needs it).
  /// Email earns its own column instead of following the address off this
  /// table because the cancellation email (criterion 80/D22) must be
  /// sendable when the draft order it would otherwise be read from may
  /// already be gone -- the address of the person to notify cannot live
  /// only on the record being cancelled. Do NOT "tidy up" by adding the
  /// postal address beside it; that reasoning does not extend to it.
  customerEmail String @map("customer_email")

  /// The instant the 24-hour guarantee (criterion 44) starts counting from.
  quotedAt           DateTime @map("quoted_at") @db.Timestamptz(6)
  guaranteeExpiresAt DateTime @map("guarantee_expires_at") @db.Timestamptz(6)

  /// Manual admin verification of payment receipt (owner §8.6/8.7, criteria
  /// 49/50). Money paired with its own currency per the F-16 convention even
  /// though it will ordinarily match the order's line currency, rather than
  /// assuming that agreement implicitly.
  verifiedPaymentAmountMinorUnits BigInt?            @map("verified_payment_amount_minor_units")
  verifiedPaymentCurrency         String?            @map("verified_payment_currency") @db.Char(3)
  /// Phase 2C-c. Was free-text `String?` -- widened to the closed
  /// `BankPaymentMethod` enum so the four electronic-only eligible methods
  /// (`CLAUDE.md` #14) are enforced by the database, not by a staff member
  /// remembering not to type "check". See migration
  /// 20260922_bank_payment_method_enum for the data checked before this
  /// column was narrowed.
  verifiedPaymentMethod           BankPaymentMethod? @map("verified_payment_method")
  /// "Reference where available" (owner §8.7) -- the one verification field
  /// that may legitimately stay NULL even once verified.
  verifiedPaymentReference        String?            @map("verified_payment_reference")
  verifiedAt                      DateTime?          @map("verified_at") @db.Timestamptz(6)
  /// Phase 2C-c revision, D23 (docs/specs/SLICE-2C-BANK-PAYMENT-CHECKOUT.md
  /// §19.1, criteria 112-114). Was a free-typed `verifiedBy String?` -- a
  /// field nobody could attribute, which is worse than no field because it
  /// still looks like evidence. Replaced by the AUTHENTICATED Shopify staff
  /// identity from the ONLINE session (`useOnlineTokens: true`,
  /// `app/shopify.server.ts`): `session.onlineAccessInfo.associated_user.id`
  /// and `.email`. Both are set together with the rest of the verification
  /// fields, or both NULL -- see `bank_payment_order_verification_pairing`.
  /// A request that carries no associated user is REFUSED, never defaulted
  /// (criterion 114) -- there is no code path that would write one of these
  /// two columns without the other.
  verifiedByShopifyUserId         BigInt?            @map("verified_by_shopify_user_id")
  verifiedByEmail                 String?            @map("verified_by_email")

  /// Set on conversion to a real Shopify order (criterion 51). Distinct from
  /// `shopifyDraftOrderGid`: the draft and the completed order are two
  /// different Shopify records.
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)
  shopifyOrderGid String?   @unique @map("shopify_order_gid")

  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason")

  /// The 24-hour guarantee sweep's own delivery record for the CUSTOMER
  /// cancellation email (spec §13/§14; owner verification list). NULL means
  /// "no cancellation email was ever attempted" -- true of every non
  /// -cancelled order, and also of a cancelled order whose email-send
  /// attempt itself never got as far as being recorded (see
  /// `cancellationEmailAttemptedAt`'s own comment).
  ///
  /// A SEPARATE enum from `AdminAlertEmailDeliveryStatus` on purpose, even
  /// though the members are identical (`sent`/`skipped_unconfigured`/
  /// `failed`): that enum is the ADMIN alert channel's delivery record: this
  /// column is the CUSTOMER cancellation email's. Reusing one enum for both
  /// would assert a relationship between "did the admin get told" and "did
  /// the customer get told" that does not exist -- they are two independent
  /// sends, on two different recipients, that can each succeed or fail on
  /// their own. Naming and typing them the same would make a future
  /// migration that adds a member to one look correct while silently
  /// changing the other's meaning too.
  cancellationEmailStatus            BankPaymentCancellationEmailStatus? @map("cancellation_email_status")
  /// The provider's own message id (proof Resend ACCEPTED the send, not
  /// merely that this code attempted one -- see `EmailPort.send`'s own doc
  /// comment). Set ONLY when `cancellationEmailStatus` is `sent`; enforced by
  /// `bank_payment_order_cancellation_email_message_id_only_when_sent`.
  cancellationEmailProviderMessageId String?                             @map("cancellation_email_provider_message_id")
  /// Set together with `cancellationEmailStatus`, always -- the sweep
  /// records both in the same write. This is the retry story in full:
  /// completion is a compare-and-set to `cancelled`, and the sweep's order
  /// query is scoped to `status = "open"`, so a cancelled order is NEVER
  /// revisited by a later sweep run. A failed or skipped cancellation email
  /// is therefore never retried automatically -- this row is the ONLY
  /// record that it needs manual follow-up, which is why it must be
  /// durable rather than a log line (owner verification list).
  cancellationEmailAttemptedAt       DateTime?                           @map("cancellation_email_attempted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines BankPaymentOrderLine[]

  @@index([status])
  @@map("bank_payment_order")
}

/// The frozen per-line quote (criteria 18, 44). APPEND-ONLY -- see migration
/// 20260919085402_pricing_input_change_and_bank_payment_line_append_only:
/// once a line is quoted, what it quoted never changes -- a corrected quote
/// is a new line on a new order, never an edit.
model BankPaymentOrderLine {
  id                 String           @id @default(uuid()) @db.Uuid
  bankPaymentOrderId String           @map("bank_payment_order_id") @db.Uuid
  bankPaymentOrder   BankPaymentOrder @relation(fields: [bankPaymentOrderId], references: [id], onDelete: Cascade)

  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])

  /// The calculation this quote was derived from (test 18: "quote stored per
  /// line with the rule and profile that produced it") -- reproducibility,
  /// exactly like `PriceOverride.priceCalculationId`.
  priceCalculationId String           @map("price_calculation_id") @db.Uuid
  priceCalculation   PriceCalculation @relation(fields: [priceCalculationId], references: [id])

  quantity Int

  /// The Bank Payment Price this line was quoted at, from the calculation's
  /// own frozen rule. Not necessarily what the customer pays -- see
  /// `eligibleAtQuoteTime`.
  quotedBankPaymentPriceMinorUnits BigInt @map("quoted_bank_payment_price_minor_units")
  /// HISTORICAL FACT, not a derivation -- the one exception the M6 spec entry
  /// calls out to C-S2 note 2's "never store the Regular/Card Price a second
  /// time" rule. Every other stored calculation re-derives the card price
  /// live from the stored Bank Payment Price; this column is instead what a
  /// specific customer was ACTUALLY quoted, frozen at quote time, independent
  /// of whatever the live calculation says a moment later. Do not "clean
  /// this up" into a derived read.
  quotedRegularCardPriceMinorUnits BigInt @map("quoted_regular_card_price_minor_units")
  currency                         String @db.Char(3)

  /// Frozen copy of `MasterVariant.bankPaymentDiscountEligible` AT QUOTE TIME
  /// (owner §7.4/§7.7 criterion 41): an ineligible line is charged the
  /// Regular/Card Price even in a bank-mode order. Recorded here so a later
  /// change to the live flag cannot rewrite what this line was actually
  /// quoted and charged.
  eligibleAtQuoteTime Boolean @map("eligible_at_quote_time")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([bankPaymentOrderId])
  @@map("bank_payment_order_line")
}

/// Shopify OAuth session storage (D13).
///
/// Shape is dictated by @shopify/shopify-app-session-storage-prisma@11 — field
/// names and types must match what the adapter reads and writes, so this model
/// does NOT follow our usual naming conventions and must not be "tidied".
///
/// DELIBERATELY MUTABLE, and the only pricing-adjacent table that is. Sessions
/// are live credentials, not evidence: they are updated on token refresh and
/// deleted on uninstall. The append-only triggers that protect the evidence
/// tables are intentionally NOT applied here — applying them would break
/// reinstall and token rotation.
///
/// CONTAINS SECRETS. `accessToken` and `refreshToken` are live Shopify
/// credentials. Never log a Session, never include one in a snapshot payload,
/// and never return one to a storefront client.
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean?
  locale        String?
  collaborator  Boolean?
  emailVerified Boolean?

  refreshToken        String?
  refreshTokenExpires DateTime?

  /// Uninstall and reinstall both operate per shop.
  @@index([shop])
  @@map("session")
}

/// Where an item is manufactured. Exactly one per variant (§ manufacturing
/// labour): a piece is made in one place, and averaging two rates would
/// produce a cost no supplier ever quoted.
enum LaborSource {
  india
  china
  usa

  @@map("labor_source")
}

/// L1 raw input — staff-entered manufacturing labour rate, charged PER GRAM.
///
/// Append-only and effective-dated, exactly like metal_price and stone_cost:
/// a price calculated last month must still be reproducible from the rate that
/// applied then, not the rate in force today.
///
/// SEPARATE FROM STONE SETTING. Setting charges are per-stone or fixed and live
/// in cost_component; this is the grams-based fabrication rate. Folding them
/// together would make a heavy plain band and a light multi-stone piece
/// indistinguishable in the breakdown.
model LaborRate {
  id            String      @id @default(uuid()) @db.Uuid
  source        LaborSource
  /// Cost per gram of finished weight, in MAJOR units (e.g. 4.500000 = $4.50/g).
  /// Decimal, never float — this is multiplied by a gram weight.
  ratePerGram   Decimal     @map("rate_per_gram") @db.Decimal(18, 6)
  currency      String      @db.Char(3)
  effectiveFrom DateTime    @map("effective_from") @db.Timestamptz(6)
  enteredBy     String      @map("entered_by")
  note          String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  /// One rate per source per instant; resolution takes the greatest
  /// effectiveFrom <= asOf.
  @@unique([source, effectiveFrom])
  @@index([source, effectiveFrom])
  @@map("labor_rate")
}

/// Group Buy campaign lifecycle. Only `draft` is editable; everything about the
/// pricing is frozen the moment it opens.
enum GroupBuyCampaignStatus {
  /// Being configured. Tiers and eligible variants may still change.
  draft
  /// Live. Pricing is FROZEN — see the triggers in this migration.
  open
  /// Ended normally. Frozen pricing stays exactly as it was.
  closed
  /// Ended without proceeding. Frozen pricing is retained as evidence.
  cancelled

  @@map("group_buy_campaign_status")
}

/// A Group Buy campaign (README, "Group Buy — Locked MVP1 Direction").
///
/// FREEZE AT OPEN is the whole point of this table. The README: "When a
/// campaign opens, freeze/version its applicable cost inputs, pricing
/// assumptions, tier thresholds/percentages, and eligible-variant prices.
/// Market changes after opening must not retroactively alter campaign tier
/// prices."
///
/// So `snapshotId` holds the resolved INPUTS, not just the resulting prices.
/// Storing only the prices would make a campaign unauditable the moment anyone
/// asked why a variant was priced as it was — and "the metal price moved since"
/// is not an answer a dispute accepts.
model GroupBuyCampaign {
  id     String                 @id @default(uuid()) @db.Uuid
  code   String                 @unique
  name   String
  status GroupBuyCampaignStatus @default(draft)

  /// Frozen at open: which profile's floors and rules this campaign was
  /// validated against. Never re-resolved afterwards.
  pricingProfileId String?         @map("pricing_profile_id") @db.Uuid
  pricingProfile   PricingProfile? @relation(fields: [pricingProfileId], references: [id])
  profileVersion   Int?            @map("profile_version")

  /// Frozen at open: every resolved cost input behind the prices below, so the
  /// campaign can be RECOMPUTED rather than merely re-read.
  snapshotId String?   @map("snapshot_id") @db.Uuid
  snapshot   Snapshot? @relation(fields: [snapshotId], references: [id])

  currency String @db.Char(3)

  /// The instant the inputs were resolved at. Recorded so a recomputation uses
  /// the same as-of the freeze did, rather than "now".
  frozenAsOf       DateTime? @map("frozen_as_of") @db.Timestamptz(6)
  openedAt         DateTime? @map("opened_at") @db.Timestamptz(6)
  /// When the campaign is due to close. Drives the storefront countdown
  /// (README "Live Savings / Progress"). Nullable: an open-ended campaign is
  /// legitimate and simply shows no countdown, which is better than inventing
  /// a deadline to satisfy a UI field.
  scheduledCloseAt DateTime? @map("scheduled_close_at") @db.Timestamptz(6)
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(6)

  /// Set when a campaign was opened despite a tier breaching a floor. Null is
  /// the normal case; a value here is a deliberate, attributed exception.
  unsafeOverrideBy     String?   @map("unsafe_override_by")
  unsafeOverrideReason String?   @map("unsafe_override_reason")
  unsafeOverrideAt     DateTime? @map("unsafe_override_at") @db.Timestamptz(6)

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// LOCKED AT CLOSE. README: "At close, final unit count/tier lock and the
  /// order becomes committed." Null while open — the live count is a fold over
  /// the unit ledger, and reading a stale cached number instead is how a
  /// campaign ends up quoting a tier it never actually reached.
  finalQualifyingUnits Int? @map("final_qualifying_units")
  finalTierNumber      Int? @map("final_tier_number")

  tiers      GroupBuyCampaignTier[]
  variants   GroupBuyCampaignVariant[]
  unitEvents GroupBuyUnitEvent[]
  refunds    GroupBuyRefund[]

  @@index([status])
  @@map("group_buy_campaign")
}

/// One tier of a campaign. Thresholds and multipliers are per-campaign DATA —
/// see app/domain/groupbuy/tiers.ts for why no boundary is hard-coded.
model GroupBuyCampaignTier {
  id         String           @id @default(uuid()) @db.Uuid
  campaignId String           @map("campaign_id") @db.Uuid
  campaign   GroupBuyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  tierNumber         Int     @map("tier_number")
  /// Qualifying units sold, not unique buyers.
  minQualifyingUnits Int     @map("min_qualifying_units")
  /// Fraction OF BASE, e.g. 0.900000 = 90% of base = 10% off. A MULTIPLIER,
  /// not a discount rate.
  priceMultiplier    Decimal @map("price_multiplier") @db.Decimal(9, 6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([campaignId, tierNumber])
  @@unique([campaignId, minQualifyingUnits])
  @@map("group_buy_campaign_tier")
}

/// An eligible variant and its FROZEN base price for this campaign.
///
/// The frozen landed cost is stored alongside the price because tier safety has
/// to be re-checkable later: without the cost, "was tier 3 above the margin
/// floor?" can only be answered by re-resolving today's costs, which is exactly
/// what freezing exists to prevent.
model GroupBuyCampaignVariant {
  id         String           @id @default(uuid()) @db.Uuid
  campaignId String           @map("campaign_id") @db.Uuid
  campaign   GroupBuyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])

  /// Frozen BANK PAYMENT base. Tier multipliers apply to this; tier safety
  /// judges it; the Group Buy card price is derived from the tier result.
  frozenBaseBankPaymentPriceMinorUnits BigInt @map("frozen_base_bank_payment_price_minor_units")
  frozenLandedCostMinorUnits           BigInt @map("frozen_landed_cost_minor_units")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([campaignId, masterVariantId])
  @@map("group_buy_campaign_variant")
}

enum GroupBuyUnitEventKind {
  purchased
  /// Cancelled before close — README allows this and it moves the tier back.
  cancelled
  /// Refunded such that the unit no longer qualifies.
  refunded

  @@map("group_buy_unit_event_kind")
}

/// Append-only ledger of qualifying-unit movements (README §430: retain
/// "qualifying-unit history, cancellations, and tier history").
///
/// AN EVENT LEDGER RATHER THAN A COUNTER. Cancellations move the count DOWN and
/// "can move the live campaign back to a prior tier before close", so the tier
/// is not a high-water mark. And a single integer would remember none of the
/// history the README requires retaining. The live count is a fold over these
/// rows — see app/domain/groupbuy/qualifyingUnits.ts.
///
/// COUNTED PER LINE ITEM, per the README: "Tier qualification and
/// cancellation/refund calculations operate at line-item/unit level."
model GroupBuyUnitEvent {
  id         String           @id @default(uuid()) @db.Uuid
  campaignId String           @map("campaign_id") @db.Uuid
  campaign   GroupBuyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])

  kind     GroupBuyUnitEventKind
  /// Always POSITIVE. Direction comes from `kind`, never from the sign — a
  /// ledger that encodes direction twice can disagree with itself.
  quantity Int

  /// Shopify order and line references. Counting happens per LINE.
  orderRef String @map("order_ref")
  lineRef  String @map("line_ref")

  /// IDEMPOTENCY KEY. A webhook redelivery must not count a unit twice, and
  /// Shopify retries are routine — our own boundary deduplicates deliveries,
  /// but this makes double-counting impossible even if something else writes.
  externalRef String @map("external_ref")

  /// When it happened at Shopify, which is not when we recorded it.
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  recordedBy String   @map("recorded_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([campaignId, externalRef])
  @@index([campaignId, lineRef])
  @@index([campaignId, createdAt])
  @@map("group_buy_unit_event")
}

/// Which of the two prices a payment was made at (owner-locked 2026-09-18).
///
/// Internal calculations always use the Bank Payment Price. This enum exists
/// for the places that must record which price a CUSTOMER actually paid,
/// because a refund or an adjustment has to be computed against the same basis
/// the money arrived in.
enum PaymentBasis {
  /// Zelle, bank transfer, designated ACH, wire, and other approved
  /// bank/manual methods. Charged the Bank Payment Price.
  bank_payment
  /// Standard credit/debit card. Charged the Regular/Card Price.
  card

  @@map("payment_basis")
}

enum GroupBuyRefundStatus {
  /// Computed and owed, HELD through production/QC. Not payable yet.
  pending
  /// Item shipped; the refund may now be processed.
  releasable
  /// Handed to the processor, awaiting its answer.
  processing
  /// Money returned to the original payment method. TERMINAL.
  issued
  /// Processor rejected it. Retryable.
  failed
  /// Nothing owed, or the line was cancelled outright. TERMINAL.
  not_owed

  @@map("group_buy_refund_status")
}

/// Tier-adjustment refund ledger (README §173).
///
/// "Calculate/store refund due at order/line-item/variant level, hold it
/// through production/QC, and process at shipping. Maintain an auditable,
/// idempotent refund ledger with campaign/order/customer/payment references,
/// original and final prices, refund amount/status, processor references,
/// failures, overrides, and history."
///
/// ONE ROW PER LINE ITEM, enforced by a unique key. That uniqueness IS the
/// duplicate-payment guard required by §371 ("Duplicate/retried refund ... must
/// not create duplicate customer value"): a second attempt to create a refund
/// for the same line cannot produce a second payable row.
///
/// Both prices are stored, not just the difference. The difference alone cannot
/// be audited — "why was this customer refunded $40?" needs what they paid and
/// what the campaign finally settled at, and those are exactly the two numbers
/// a dispute asks for.
model GroupBuyRefund {
  id         String           @id @default(uuid()) @db.Uuid
  campaignId String           @map("campaign_id") @db.Uuid
  campaign   GroupBuyCampaign @relation(fields: [campaignId], references: [id])

  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])

  orderRef    String  @map("order_ref")
  lineRef     String  @map("line_ref")
  /// Shopify customer id — an identifier, never a name or email. PII stays in
  /// Shopify (README security: minimise PII).
  customerRef String? @map("customer_ref")

  /// WHICH PRICE THE CUSTOMER PAID. A card customer paid the Regular/Card Price
  /// and a bank customer paid the Bank Payment Price, so the two amounts below
  /// are only comparable once the basis is known. Refunding a card payment
  /// against a bank tier price would hand back the whole uplift too — 3-5% of
  /// the order, on every card line, at every tier drop.
  paymentBasis           PaymentBasis @map("payment_basis")
  /// What the customer actually paid, per unit, IN `paymentBasis`.
  paidPerUnitMinorUnits  BigInt       @map("paid_per_unit_minor_units")
  /// The campaign's final tier price, per unit, in the SAME basis.
  finalPerUnitMinorUnits BigInt       @map("final_per_unit_minor_units")
  /// Units still qualifying on this line at close.
  qualifyingUnits        Int          @map("qualifying_units")
  /// (paid - final) x units, floored at zero — a refund never becomes a charge.
  refundAmountMinorUnits BigInt       @map("refund_amount_minor_units")
  currency               String       @db.Char(3)

  status GroupBuyRefundStatus @default(pending)

  /// Processor reference and failure text, per §173.
  processorReference String? @map("processor_reference")
  failureReason      String? @map("failure_reason")

  /// Manual intervention, per §173 ("overrides") and §189 ("retain manual
  /// override with audit history").
  overrideBy     String?   @map("override_by")
  overrideReason String?   @map("override_reason")
  overrideAt     DateTime? @map("override_at") @db.Timestamptz(6)

  computedAt DateTime  @default(now()) @map("computed_at") @db.Timestamptz(6)
  /// When shipping released the hold. Null while held through production/QC.
  releasedAt DateTime? @map("released_at") @db.Timestamptz(6)
  issuedAt   DateTime? @map("issued_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  events GroupBuyRefundEvent[]

  @@unique([campaignId, lineRef])
  @@index([campaignId, status])
  @@map("group_buy_refund")
}

/// Append-only history of every refund status change (§173 "history").
///
/// The refund row carries the CURRENT state; this carries how it got there.
/// Without it, a refund that failed twice and then succeeded is
/// indistinguishable from one that succeeded first time — and the difference
/// matters when a customer asks why their money took three weeks.
model GroupBuyRefundEvent {
  id       String         @id @default(uuid()) @db.Uuid
  refundId String         @map("refund_id") @db.Uuid
  refund   GroupBuyRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  fromStatus GroupBuyRefundStatus? @map("from_status")
  toStatus   GroupBuyRefundStatus  @map("to_status")
  reason     String?
  actor      String
  /// Processor reference or failure text captured at this transition.
  detail     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([refundId, createdAt])
  @@map("group_buy_refund_event")
}

// =============================================================================
// Slice 3 — Luxury Steals (docs/specs/SLICE-3-LUXURY-STEALS.md, task 3-1).
// `MasterVariant.isLuxurySteal` above (M11) is the assignment; this table
// (M12) is the order-boundary evidence — see that model's own doc comment
// for why it exists and what it must never be allowed to omit.
// =============================================================================

/// Whether an `orders/create` line matched stored Final Sale acknowledgment
/// evidence. Recorded EITHER WAY (criterion 140) — `matched` is evidence
/// too, and its absence later would be indistinguishable from "never
/// checked". Task 3-4 (the webhook) is the only intended writer; this slice
/// only gives it the table and the repository functions to write through.
enum LuxuryStealOrderCheckOutcome {
  matched
  unmatched

  @@map("luxury_steal_order_check_outcome")
}

/// Append-only evidence (see migration 20260913000100's convention, extended
/// to this table by this slice's migration). Criteria 137-140: an
/// `orders/create` webhook verifies EVERY Luxury Steal line against stored
/// acknowledgment evidence, and this is the durable record of that check —
/// one row per ORDER LINE checked, not per order.
///
/// `orderRef`/`lineRef`/`variantRef` are plain Shopify GID strings, matching
/// the existing ref convention already established on `Acknowledgment`
/// (`orderRef`/`productRef`/`variantRef` there hold values like
/// `"gid://shopify/Order/1"` — see `acknowledgment.test.ts`) rather than
/// internal foreign keys: the order-time check runs from the webhook
/// payload, which carries Shopify identifiers directly, and task 3-4 (not
/// this task) owns resolving `variantRef` to a `MasterVariant` when it needs
/// to query the M11 assignment column.
///
/// IDEMPOTENCY (criterion 139): `@@unique([orderRef, lineRef])` is what lets
/// a redelivered `orders/create` be a no-op re-read rather than a second
/// hold or a second evidence row — the same compare-and-set-then-read-on-
/// conflict idiom `webhook_event`/`idempotency_key` already use.
model LuxuryStealOrderCheck {
  id String @id @default(uuid()) @db.Uuid

  orderRef   String @map("order_ref")
  lineRef    String @map("line_ref")
  variantRef String @map("variant_ref")

  /// Populated only when `outcome = matched` — enforced by a CHECK in this
  /// slice's migration raw SQL, mirroring how `price_override` couples
  /// `kind` to its price column. Nullable FK: an `unmatched` outcome, by
  /// definition, found no acknowledgment to point at.
  matchedAcknowledgmentId String?         @map("matched_acknowledgment_id") @db.Uuid
  matchedAcknowledgment   Acknowledgment? @relation(fields: [matchedAcknowledgmentId], references: [id])

  outcome   LuxuryStealOrderCheckOutcome
  checkedAt DateTime                     @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@unique([orderRef, lineRef])
  @@index([orderRef])
  @@index([variantRef])
  @@map("luxury_steal_order_check")
}

/// Slice 3 task 3-2b (docs/specs/SLICE-3-LUXURY-STEALS.md criterion 152).
/// One row per FAILURE EPISODE of the `carat.luxury_steal` metafield sync for
/// a variant -- never per attempt, same idea as `PriceSyncFailure`.
///
/// DELIBERATELY NOT `PriceSyncFailure`, AND DELIBERATELY MISSING ITS
/// `suspendedAt`/`alertState`/`dismissed*` COLUMNS. CLAUDE.md rule 17 governs
/// a failed PRICE publish: hold the last price, retry, alert, and after 48
/// hours unresolved make the variant unavailable. Criterion 152 narrows that
/// rule for this one non-money cache: a failed price sync leaves Shopify
/// selling at a wrong number, so withdrawing the variant is the safe end
/// state; a failed Luxury Steal metafield sync only leaves the storefront
/// missing a badge/disclosure/acknowledgment gate, and criterion 127 already
/// makes that fail SAFE the other way -- the order-time check reads Postgres,
/// never this cache, so an unsynced variant is still caught and held rather
/// than fulfilled. Reusing `PriceSyncFailure` (or copying its full column
/// set) would risk that 48-hour consequence leaking back in by reflex; this
/// table has no `suspendedAt` at all, so there is nothing for any reader to
/// mistake for a purchasability signal. No dismissible alert either -- no
/// owner ruling describes a persistent alert here to silence, mirroring why
/// `PriceCalculationFailure` also carries no `alertState`/`dismissed*`.
///
/// `resolvedTrigger` mirrors `PriceCalculationFailure.resolvedTrigger`: this
/// episode can close either from the bounded immediate retry at write time
/// or from a human clicking "Retry sync" in the admin page, and recording
/// which one happened is cheap and useful for support/audit -- unlike
/// `PriceSyncFailure`'s resolution, which only ever means "a later sync
/// succeeded" with nothing further to name.
model LuxuryStealSyncFailure {
  id              String        @id @default(uuid()) @db.Uuid
  masterVariantId String        @map("master_variant_id") @db.Uuid
  masterVariant   MasterVariant @relation(fields: [masterVariantId], references: [id])

  firstFailedAt DateTime @map("first_failed_at") @db.Timestamptz(6)
  lastAttemptAt DateTime @map("last_attempt_at") @db.Timestamptz(6)
  attemptCount  Int      @default(1) @map("attempt_count")
  lastError     String   @map("last_error")

  /// A later sync succeeded -- either the bounded immediate retry at write
  /// time or a manual "Retry sync" in the admin page. Closes the episode.
  /// Never touches purchasability -- there is nothing here that does.
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedTrigger String?   @map("resolved_trigger")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// At most one OPEN episode per variant (partial unique index, this
  /// migration's raw SQL -- Prisma cannot express it), mirroring
  /// price_sync_failure_one_open_per_variant / price_calculation_failure_one_open_per_variant.
  @@index([masterVariantId])
  @@map("luxury_steal_sync_failure")
}

// =============================================================================
// Slice 5 — Warranty Claims (docs/WARRANTY-CLAIMS.md — locked policy,
// docs/specs/SLICE-5-WARRANTY-CLAIMS.md, task 5-1). M13-M16 plus one
// internal-only satellite table (below). Ref columns (orderRef/lineRef/
// customerRef) follow the plain-Shopify-GID-string convention already
// established on `Acknowledgment` and `LuxuryStealOrderCheck` — a claim is
// filed against whatever Shopify reports, and resolving those refs against
// `MasterVariant` (when possible) is the intake route's job (task 5-3), not
// this task's.
//
// STATE MACHINE. The authoritative transition rules live in the PURE domain
// function `app/domain/warranty/claimStatus.ts` — read that module's header
// first; this schema's `warranty_claim_guard` trigger (this slice's
// migration, hand-authored SQL) is a database-level mirror of the exact same
// table, not an independent design, so the two must be read and changed
// together. Two facts are enforced STRUCTURALLY, at both layers (criteria
// 159/168):
//   - a coverage decision (`approved_covered`/`denied_not_covered`) is only
//     reachable through `received_inspection_pending`, and is additionally
//     gated on `received_at IS NOT NULL` by a CHECK constraint independent of
//     the transition table itself (belt-and-suspenders: even a hand-crafted
//     UPDATE that satisfies the transition graph still cannot decide a claim
//     with no recorded receipt);
//   - `resolved` is only reachable from `remedy_in_progress` (which itself
//     requires `approved_covered`) or from `denied_not_covered` — never
//     directly from an undecided status.
// =============================================================================

/// The eleven statuses of WARRANTY-CLAIMS.md §8, modelled as an explicit
/// directed graph (see `app/domain/warranty/claimStatus.ts`). Adding a value
/// here without also adding it to that module's transition table AND this
/// slice's `warranty_claim_guard` trigger leaves it unreachable — the graph
/// is stated as what IS allowed, not what is forbidden (same fail-closed
/// design as `group_buy_campaign_guard`), so an unrecognised status has no
/// legal way in.
enum WarrantyClaimStatus {
  submitted
  under_review
  /// A pause state, not a fork. `pausedFromStatus` on the claim row records
  /// exactly which status it paused FROM, and resuming returns to exactly
  /// that status — never to a caller-chosen destination. This is what makes
  /// it safe for this state to be reachable both before and after receipt
  /// (`under_review` and `received_inspection_pending` both request more
  /// information) without ever letting "ask for more info, then resume"
  /// become a shortcut around actually recording receipt — see the domain
  /// module's header comment for the full reasoning.
  more_information_requested
  /// Set only by an explicit authenticated-staff act (criterion 157) — never
  /// inferred. `authorizedAt`/`authorizedByActorRef` below record it; this
  /// status existing is what criterion 156 gates shipping instructions on.
  authorized_for_inspection
  in_transit_to_carat_for_us
  /// Reaching this status is the ONLY thing that sets `receivedAt` (criterion
  /// 159) — package/item condition and inspection evidence are recorded with
  /// it.
  received_inspection_pending
  /// Covered. `coverageDecision = covered`.
  approved_covered
  /// Not covered. `coverageDecision = not_covered` AND `coverageDecisionReason`
  /// is required — CHECK constraint `warranty_claim_denial_requires_reason`
  /// (criterion 160).
  denied_not_covered
  /// CaratForUs has selected the remedy (`WarrantyClaimRemedy`, never the
  /// customer — criterion 162) and it is being executed.
  remedy_in_progress
  resolved
  closed

  @@map("warranty_claim_status")
}

enum WarrantyCoverageDecision {
  covered
  not_covered

  @@map("warranty_coverage_decision")
}

enum WarrantyRemedyKind {
  repair
  replacement
  refund
  /// "Another reasonable resolution when required/appropriate" — §6.
  other

  @@map("warranty_remedy_kind")
}

enum WarrantyClaimRemedyStatus {
  pending
  processing
  completed
  failed

  @@map("warranty_claim_remedy_status")
}

enum WarrantyClaimUploadKind {
  photo
  video

  @@map("warranty_claim_upload_kind")
}

/// M13. The claim itself — intake (§2), authorisation (§3), inbound shipping
/// evidence (§4), receipt/inspection (§5) and the current coverage decision
/// summary. `events` (M14) is the append-only history of how it got here;
/// this row is the current-state projection, same relationship as
/// `GroupBuyRefund` to `GroupBuyRefundEvent`.
model WarrantyClaim {
  id             String @id @default(uuid()) @db.Uuid
  /// Customer/support-facing reference (e.g. "WC-000123"). Generated by the
  /// repository layer (task 5-2), not by a DB default/sequence, so its format
  /// stays an application decision.
  claimReference String @unique @map("claim_reference")

  orderRef    String  @map("order_ref")
  lineRef     String  @map("line_ref")
  /// "customer/account ID when available" (§2) — nullable because a guest
  /// checkout may not carry one.
  customerRef String? @map("customer_ref")

  /// Resolved link to the internal design/cost definition, when the intake
  /// route (task 5-3) can resolve `lineRef`/`variantRef` to one. Nullable:
  /// criterion 155 refuses a claim whose ORDER/LINE cannot be resolved, but a
  /// resolved order line does not guarantee a `MasterVariant` match exists
  /// for every historical/Shopify-native SKU — that gap is recorded here as
  /// "unresolved", not guessed at.
  masterVariantId              String?        @map("master_variant_id") @db.Uuid
  masterVariant                MasterVariant? @relation(fields: [masterVariantId], references: [id])
  /// Free-text "exact item/line item and configuration" (§2) as submitted —
  /// always populated, independent of whether `masterVariantId` resolves.
  itemConfigurationDescription String         @map("item_configuration_description")

  purchaserName  String @map("purchaser_name")
  purchaserEmail String @map("purchaser_email")

  purchaseDate          DateTime? @map("purchase_date") @db.Date
  /// "carrier-confirmed delivery date where available" (§2).
  deliveryDate          DateTime? @map("delivery_date") @db.Date
  issueFirstNoticedDate DateTime? @map("issue_first_noticed_date") @db.Date

  problemDescription String @map("problem_description")

  hadImpactOrDamageEvent Boolean @map("had_impact_or_damage_event")
  impactOrDamageDetails  String? @map("impact_or_damage_details")

  wasAlteredAfterDelivery Boolean @map("was_altered_after_delivery")
  alterationDetails       String? @map("alteration_details")

  certificateOrSerialIdentifier String? @map("certificate_or_serial_identifier")

  /// Criterion 154 — "submitting a claim does not mark it covered" is
  /// captured as EVIDENCE, not a checkbox column. Both acknowledgments are
  /// REQUIRED (NOT NULL FK) so no claim row can exist without them having
  /// been recorded through the slice 0 `Acknowledgment` model.
  accuracyCertificationAcknowledgmentId  String         @map("accuracy_certification_acknowledgment_id") @db.Uuid
  accuracyCertificationAcknowledgment    Acknowledgment @relation("WarrantyClaimAccuracyCertification", fields: [accuracyCertificationAcknowledgmentId], references: [id])
  coverageNotEstablishedAcknowledgmentId String         @map("coverage_not_established_acknowledgment_id") @db.Uuid
  coverageNotEstablishedAcknowledgment   Acknowledgment @relation("WarrantyClaimCoverageNotEstablished", fields: [coverageNotEstablishedAcknowledgmentId], references: [id])

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  status           WarrantyClaimStatus  @default(submitted)
  /// Meaningful ONLY while `status = more_information_requested` — the exact
  /// status `resume_after_more_information` returns to. See this file's
  /// section header and `app/domain/warranty/claimStatus.ts`.
  pausedFromStatus WarrantyClaimStatus? @map("paused_from_status")

  /// §3 — set only by `authorize_for_inspection`, never inferred (criterion
  /// 157). Criterion 156 (no shipping instruction before this) is enforced by
  /// task 5-3/5-4's route layer reading THIS field, never a status string
  /// comparison that a future status value could quietly slip past.
  authorizedAt         DateTime? @map("authorized_at") @db.Timestamptz(6)
  authorizedByActorRef String?   @map("authorized_by_actor_ref")

  /// §4 — retained "where available" (§4), i.e. optional even on an
  /// authorised claim: the customer may not have shipped yet.
  inboundTrackingCarrier        String? @map("inbound_tracking_carrier")
  inboundTrackingNumber         String? @map("inbound_tracking_number")
  inboundInsuranceReference     String? @map("inbound_insurance_reference")
  inboundInsuredValueMinorUnits BigInt? @map("inbound_insured_value_minor_units")
  inboundInsuredValueCurrency   String? @map("inbound_insured_value_currency") @db.Char(3)

  /// §5 — set only by `record_receipt`. `receivedAt` is criterion 159's gate;
  /// see `warranty_claim_decision_requires_receipt` and
  /// `warranty_claim_guard` in this slice's migration.
  receivedAt          DateTime? @map("received_at") @db.Timestamptz(6)
  packageCondition    String?   @map("package_condition")
  itemCondition       String?   @map("item_condition")
  inspectionNotes     String?   @map("inspection_notes")
  inspectedByActorRef String?   @map("inspected_by_actor_ref")

  /// §5/§6 — set only by `decide_coverage`. `coverageDecisionReason` is
  /// REQUIRED when `coverageDecision = not_covered`
  /// (`warranty_claim_denial_requires_reason`, criterion 160); optional for
  /// `covered`.
  coverageDecision          WarrantyCoverageDecision? @map("coverage_decision")
  coverageDecisionReason    String?                   @map("coverage_decision_reason")
  coverageDecidedAt         DateTime?                 @map("coverage_decided_at") @db.Timestamptz(6)
  coverageDecidedByActorRef String?                   @map("coverage_decided_by_actor_ref")

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events  WarrantyClaimEvent[]
  uploads WarrantyClaimUpload[]
  remedy  WarrantyClaimRemedy?

  @@index([orderRef])
  @@index([status])
  @@index([customerRef])
  @@index([masterVariantId])
  @@map("warranty_claim")
}

/// M14. Append-only (this slice's migration extends the
/// `prevent_evidence_mutation`/`prevent_evidence_truncate` triggers from
/// migrations 20260913000100/20260914000000). Criterion 169 — WHO
/// (`actorType`/`actorRef`), WHEN (`createdAt`), FROM/TO (`fromStatus`/
/// `toStatus`), and WHY (`reason`, plus `metadata` for the supporting facts
/// recorded at that specific transition — e.g. tracking/insurance values
/// captured at authorisation, package/item condition captured at receipt).
/// `fromStatus` is nullable only for the single event created alongside
/// claim submission, which has no prior status.
model WarrantyClaimEvent {
  id      String        @id @default(uuid()) @db.Uuid
  claimId String        @map("claim_id") @db.Uuid
  claim   WarrantyClaim @relation(fields: [claimId], references: [id])

  fromStatus WarrantyClaimStatus? @map("from_status")
  toStatus   WarrantyClaimStatus  @map("to_status")

  actorType ActorType @map("actor_type")
  actorRef  String?   @map("actor_ref")
  reason    String?
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([claimId, createdAt])
  @@map("warranty_claim_event")
}

/// M15. Upload REFERENCES only — key, content type, size, checksum. Never
/// the bytes (spec §5: uploads go behind a port; the production storage
/// adapter lands when `STORAGE_*` credentials do — this table is that port's
/// domain-side record and does not change shape when the adapter arrives).
/// Append-only: an uploaded piece of evidence is never silently edited or
/// removed, same reasoning as every other evidence table in this schema.
model WarrantyClaimUpload {
  id      String        @id @default(uuid()) @db.Uuid
  claimId String        @map("claim_id") @db.Uuid
  claim   WarrantyClaim @relation(fields: [claimId], references: [id])

  kind        WarrantyClaimUploadKind @map("kind")
  storageKey  String                  @map("storage_key")
  contentType String                  @map("content_type")
  sizeBytes   BigInt                  @map("size_bytes")
  checksum    String

  uploadedByActorType ActorType @map("uploaded_by_actor_type")
  uploadedByActorRef  String?   @map("uploaded_by_actor_ref")
  uploadedAt          DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  @@index([claimId])
  @@map("warranty_claim_upload")
}

/// M16. The remedy CaratForUs selected (§6) and its external references.
/// Never customer-selected (criterion 162) — nothing here is written from a
/// customer-facing input; task 5-2's repository only exposes a staff/admin
/// write path.
///
/// IDEMPOTENCY (criterion 163): `@@unique([claimId])` — at most ONE remedy
/// row per claim, structurally. A retried or duplicated "process this
/// claim's remedy" call cannot insert a second payable/executable row; it
/// hits the constraint and must read back the existing row instead (task
/// 5-2's job). Retries of a FAILED remedy update `status`/`failureReason`/
/// `processorReference` on this same row rather than inserting a new one —
/// mirroring `GroupBuyRefund`'s single-row-per-line design, not a
/// read-then-write race.
///
/// Money (criterion 164): refund fields are BigInt minor units + CHAR(3)
/// currency, populated if and only if `kind = refund`
/// (`warranty_claim_remedy_refund_money_coherent`, this slice's migration —
/// mirrors `price_override_kind_bank_payment_price_coherent`'s coupling
/// style). `repair`/`replacement`/`other` carry no money here; a refund
/// remedy still executes through Shopify (spec §6), this row is the record
/// of that decision and its outcome, not a parallel payment rail.
model WarrantyClaimRemedy {
  id      String        @id @default(uuid()) @db.Uuid
  claimId String        @unique @map("claim_id") @db.Uuid
  claim   WarrantyClaim @relation(fields: [claimId], references: [id])

  kind   WarrantyRemedyKind
  status WarrantyClaimRemedyStatus @default(pending)

  refundAmountMinorUnits BigInt? @map("refund_amount_minor_units")
  currency               String? @map("currency") @db.Char(3)

  processorReference String? @map("processor_reference")
  failureReason      String? @map("failure_reason")

  decidedByActorRef String    @map("decided_by_actor_ref")
  decidedAt         DateTime  @map("decided_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  localJewellerAuthorization WarrantyClaimLocalJewellerAuthorization?

  @@map("warranty_claim_remedy")
}

/// INTERNAL ONLY (§7, criteria 165-166). Deliberately its OWN table, joined
/// only by `remedyId`, rather than columns on `WarrantyClaim` or even on
/// `WarrantyClaimRemedy` itself. Reasoning (criterion 165's "structurally
/// obvious", not just commented): the natural query for any customer-facing
/// claim view — status page, confirmation email, an API response a
/// storefront can read — is "this claim" or "this claim's remedy", i.e.
/// `warranty_claim` and/or `warranty_claim_remedy` alone. Neither of those
/// tables carries a single jeweller column, so a customer-facing serialiser
/// built the obvious way (select the claim, select its remedy) cannot leak
/// this data by accident; leaking it would require a DELIBERATE extra join
/// to a table named, unambiguously, `..._local_jeweller_authorization`. Task
/// 5-2's repository must not expose a read of this table from any
/// customer-reachable function, and task 5-3 (customer intake/status routes)
/// must never import it — noted here for that task's and QA's benefit.
///
/// Retains exactly what criterion 166 lists: jeweller selection, the
/// authorisation and approved scope/cost, communications, invoice/payment
/// evidence, and completion evidence. `@@unique([remedyId])` — at most one
/// jeweller arrangement per remedy, matching the remedy's own one-row-per-
/// claim design.
model WarrantyClaimLocalJewellerAuthorization {
  id       String              @id @default(uuid()) @db.Uuid
  remedyId String              @unique @map("remedy_id") @db.Uuid
  remedy   WarrantyClaimRemedy @relation(fields: [remedyId], references: [id])

  jewellerName    String  @map("jeweller_name")
  jewellerContact String? @map("jeweller_contact")

  authorizedScope          String   @map("authorized_scope")
  authorizedCostMinorUnits BigInt   @map("authorized_cost_minor_units")
  authorizedCostCurrency   String   @map("authorized_cost_currency") @db.Char(3)
  authorizedByActorRef     String   @map("authorized_by_actor_ref")
  authorizedAt             DateTime @map("authorized_at") @db.Timestamptz(6)

  /// "communications" (criterion 166) — free-text log; a structured thread
  /// is out of scope for MVP1 and not requested.
  communicationsLog String? @map("communications_log")

  invoiceReference        String? @map("invoice_reference")
  invoiceAmountMinorUnits BigInt? @map("invoice_amount_minor_units")
  invoiceAmountCurrency   String? @map("invoice_amount_currency") @db.Char(3)
  paymentReference        String? @map("payment_reference")
  /// Criterion 167 — reimbursement is NEVER automatic. A value here records a
  /// specific manual decision after the fact; nothing in the workflow writes
  /// it as a side effect of anything else.
  reimbursementReference  String? @map("reimbursement_reference")

  completionEvidence String?   @map("completion_evidence")
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("warranty_claim_local_jeweller_authorization")
}

// =============================================================================
// Slice 11 (subset) — Shipment Evidence (docs/specs/SLICE-11-SHIPMENT-
// EVIDENCE.md, docs/specs/SLICE-11-READINESS.md, task 5-1-equivalent scope:
// schema + pure domain only). ONE ROW PER OUTBOUND PACKAGE — what staff
// actually arranged with a carrier, recorded as fact, not what a policy
// threshold would compute.
//
// UPDATED FOR D29-D31 (docs/ARCHITECTURE-MVP1.md, resolved 2026-09-25;
// domain enforcement in app/app/domain/shipping/**, committed 7fc17f0). The
// boundary above no longer applies verbatim — "order value" is now defined
// (D29: shipment merchandise value) and the $100.00 threshold is now real
// (D31) — but two things it protected remain true and are still enforced
// below: this schema does not compute the threshold itself (the domain
// module owns `decideStandardSignatureRequirementByRule`; this schema only
// HOLDS what that function and a staff override produced), and G2 (what
// insurance mechanism/provider can reach full merchandise value on a
// high-value piece) is still unanswered, so `insuredValueMinorUnits` is
// never forced to equal `computedMerchandiseValueMinorUnits` below — see
// that field's own doc comment.
// =============================================================================

/// D31 — matches `app/app/domain/shipping/signatureRequirement.ts`'s
/// `SignatureRequirementSource` exactly (`"rule" | "staff_override"`).
/// Recording ONLY that a signature was required, without recording why,
/// loses the accountability D31 asks for: "the rule fired on its own" and "a
/// named person decided" are different facts, and only the second has
/// someone answerable for it.
enum SignatureRequiredSource {
  rule
  staff_override

  @@map("signature_required_source")
}

/// D31 — matches `app/app/domain/shipping/signatureRequirement.ts`'s
/// `SignatureServiceUsed` exactly. Evidence of what happened, which may
/// differ from what `signatureRequired`/`signatureRequiredSource` say was
/// required — staff may apply a stricter service than the rule demanded,
/// and this column records the reality, not the policy.
enum SignatureServiceUsed {
  none
  standard
  adult_signature_required

  @@map("signature_service_used")
}

/// M-shipment (criteria 171-175, 179). Tracking is NOT NULL — criterion 172:
/// "every shipment has tracking" is unconditional in README, so a shipment
/// row cannot exist without one, structurally, rather than as a convention a
/// caller could skip. `shipDate` is likewise NOT NULL: this row represents a
/// package that has actually shipped, not a fulfillment-pending placeholder.
model Shipment {
  id String @id @default(uuid()) @db.Uuid

  /// Shopify order reference (plain GID string, matching the
  /// `Acknowledgment`/`LuxuryStealOrderCheck` ref convention) — one order MAY
  /// have more than one `Shipment` row (split packages); each package is
  /// independently tracked/insured, consistent with README's rule applying
  /// per shipment, not per order. `lineRefs` is not modelled here — no
  /// document specifies split-shipment line attribution, and inventing that
  /// mapping is out of this task's scope (see spec §8).
  orderRef String @map("order_ref")

  carrier        String
  service        String?
  /// Criterion 172 — unconditional, never null.
  trackingNumber String   @map("tracking_number")
  shipDate       DateTime @map("ship_date") @db.Date

  /// Criterion 173 — money as integer minor units + currency, present
  /// together or absent together (`shipment_insured_value_coherent`, this
  /// slice's migration). D30/G2 — this is what was ACTUALLY ARRANGED with
  /// the carrier/insurer, never forced to equal `computedMerchandiseValueMinorUnits`
  /// below: no insurance provider is named for reaching full merchandise
  /// value on a high-value piece (G2, still open), so the two figures are
  /// allowed to differ visibly rather than one silently overwriting the
  /// other — a mismatch is information for staff to see, not an error to
  /// normalise away.
  insuredValueMinorUnits BigInt? @map("insured_value_minor_units")
  insuredValueCurrency   String? @map("insured_value_currency") @db.Char(3)
  insuranceReference     String? @map("insurance_reference")

  /// D29 — the OUTPUT of `computeShipmentMerchandiseValue` for this
  /// shipment's contents: what the D29/D31 rule actually computed, kept
  /// distinct from `insuredValueMinorUnits` (what staff arranged) per D30.
  /// Nullable: a shipment recorded before this figure was computed (or by a
  /// caller that hasn't wired the computation up yet) simply has none yet —
  /// this column does not gate anything else on this row.
  computedMerchandiseValueMinorUnits BigInt? @map("computed_merchandise_value_minor_units")
  computedMerchandiseValueCurrency   String? @map("computed_merchandise_value_currency") @db.Char(3)

  /// Criterion 174/D31 — `signatureRequired` is the ACTUAL requirement for
  /// this shipment (rule, or a staff override upgrading it — see
  /// `resolveShipmentSignatureRequirement`). `signatureRequiredSource`
  /// distinguishes which produced it; NOT NULL, defaulting to `rule` (the
  /// same default posture as `signatureRequired` itself — absent any staff
  /// action, the rule alone is the source of record). The
  /// `signatureRequiredSetByActorRef`/`SetAt` pair is populated if and only
  /// if `signatureRequiredSource = staff_override`
  /// (`shipment_signature_source_coherent`, this slice's migration) — it is
  /// the OVERRIDE's provenance specifically, not a general-purpose "who
  /// touched this row" field.
  signatureRequired              Boolean                 @default(false) @map("signature_required")
  signatureRequiredSource        SignatureRequiredSource @default(rule) @map("signature_required_source")
  signatureRequiredSetByActorRef String?                 @map("signature_required_set_by_actor_ref")
  signatureRequiredSetAt         DateTime?               @map("signature_required_set_at") @db.Timestamptz(6)
  /// D31 — the service ACTUALLY USED, which may differ from what
  /// `signatureRequired` says was required (a carrier substitution, a staff
  /// mistake, whatever the real world produced). Evidence, never derived —
  /// see `app/app/domain/shipping/signatureRequirement.ts`'s
  /// `SignatureServiceUsed`, which has no function that computes this value.
  signatureServiceUsed           SignatureServiceUsed?   @map("signature_service_used")

  /// "Delivery evidence" (criterion 171) — what the carrier confirmed, not
  /// what the app predicts. Both nullable: a freshly-recorded shipment has
  /// not been delivered yet.
  deliveredAt                   DateTime? @map("delivered_at") @db.Timestamptz(6)
  deliveryConfirmationReference String?   @map("delivery_confirmation_reference")
  proofOfSignatureReference     String?   @map("proof_of_signature_reference")

  /// Criterion 176 — the address this shipment is going to. Populated by the
  /// caller (a later repository/route task) from the checkout/payment-
  /// approved address; this schema does not fetch or validate it against
  /// Shopify — see spec §8. Plain fields, not JSON, so `ShipmentAddressChangeEvent`
  /// below can carry the same shape symmetrically.
  addressLine1      String  @map("address_line1")
  addressLine2      String? @map("address_line2")
  addressCity       String  @map("address_city")
  addressRegion     String? @map("address_region")
  addressPostalCode String  @map("address_postal_code")
  addressCountry    String  @map("address_country")

  /// Criterion 179 — staff provenance. Never a customer-submitted value: a
  /// shipment row is staff's record of what they arranged, not a form a
  /// customer fills in.
  enteredByActorRef String   @map("entered_by_actor_ref")
  enteredAt         DateTime @default(now()) @map("entered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  addressChanges ShipmentAddressChangeEvent[]

  @@index([orderRef])
  @@index([trackingNumber])
  @@map("shipment")
}

/// Criteria 176-178 — append-only (this slice's migration extends
/// `prevent_evidence_mutation`/`prevent_evidence_truncate`, migrations
/// 20260913000100/20260914000000, unchanged). A change is recorded, never
/// overwritten in place: the before/after address, who changed it, when, and
/// why when given. `reason` is optional, mirroring `AuditEvent.reason`'s own
/// optionality — this repo has never required a reason to make an audit
/// trail valid, only that one be captured when offered.
model ShipmentAddressChangeEvent {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @map("shipment_id") @db.Uuid
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  fromAddressLine1      String  @map("from_address_line1")
  fromAddressLine2      String? @map("from_address_line2")
  fromAddressCity       String  @map("from_address_city")
  fromAddressRegion     String? @map("from_address_region")
  fromAddressPostalCode String  @map("from_address_postal_code")
  fromAddressCountry    String  @map("from_address_country")

  toAddressLine1      String  @map("to_address_line1")
  toAddressLine2      String? @map("to_address_line2")
  toAddressCity       String  @map("to_address_city")
  toAddressRegion     String? @map("to_address_region")
  toAddressPostalCode String  @map("to_address_postal_code")
  toAddressCountry    String  @map("to_address_country")

  reason String?

  actorType ActorType @map("actor_type")
  actorRef  String?   @map("actor_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([shipmentId, createdAt])
  @@map("shipment_address_change_event")
}

// ---------------------------------------------------------------------------
// Slice 4 — Buy Now RMA (docs/specs/SLICE-4-BUY-NOW-RMA.md, criteria
// 180-204). Schema + pure domain only this task — see that spec §8 for what
// is deliberately not built here (repository, routes, Shopify adapters).
// ---------------------------------------------------------------------------

/// Criterion 185. `standard` = requested within 7 calendar days of delivery
/// (policy §3); `late` = requested on day 8-30 (policy §4). There is no
/// `ineligible` value here — day 31+ is refused before an `RmaRequest` row is
/// ever created (see `classifyReturnWindow` in
/// `app/app/domain/rma/window.ts`), so every persisted request already has a
/// window, or none yet (`submitted`, pre-approval).
enum RmaWindowKind {
  standard
  late

  @@map("rma_window_kind")
}

/// Criterion 182 — exact match to policy §9's list. `requiresClaimWorkflow`
/// in `app/app/domain/rma/eligibility.ts` names which four of these route
/// away from this discretionary workflow entirely.
enum RmaReasonCategory {
  buyer_remorse
  size_fit
  style_preference
  alleged_defect
  wrong_item_or_specification
  transit_damage
  materially_not_as_described
  other

  @@map("rma_reason_category")
}

/// Criterion 187 — the CUSTOMER's choice in the late window only (policy
/// §4). See spec §3: this is the opposite of
/// `WarrantyRemedyKind`/criterion 162, where the customer never chooses.
enum RmaRemedyKind {
  refund_original_payment
  merchandise_credit

  @@map("rma_remedy_kind")
}

/// Criterion 202. Named distinctly from `WarrantyCoverageDecision` because
/// this is a CONDITION-AT-RECEIPT judgement (policy §7), not a coverage
/// determination — a different question with a structurally identical
/// accept/reject-with-reason shape.
enum RmaConditionDecision {
  accepted
  rejected

  @@map("rma_condition_decision")
}

/// Criteria 156-201-equivalent state machine. Mirrors
/// `app/app/domain/warranty/claimStatus.ts`'s shape closely — see
/// `app/app/domain/rma/status.ts` for the pure transition table this
/// migration's guard trigger mirrors. No `more_information_requested`
/// pause state: nothing in the locked policy calls for one, and inventing a
/// pause/resume mechanism beyond what's needed would be exactly the kind of
/// speculative addition CLAUDE.md's implementation discipline forbids.
enum RmaStatus {
  submitted
  approved
  denied
  return_shipped
  expired
  received_inspection_pending
  inspection_passed
  inspection_failed
  remedy_in_progress
  resolved
  closed

  @@map("rma_status")
}

/// Criterion 194. `staff_review_required` is D7's fail-closed state — a
/// distinct predecessor from `failed`, because retrying the identical
/// operation would hit the same tax/representability problem, so neither
/// this enum's ordering nor the transition table treats it as a plain retry
/// case. See `app/app/domain/rma/remedy.ts`.
enum RmaRemedyStatus {
  pending
  processing
  issued
  failed
  staff_review_required

  @@map("rma_remedy_status")
}

/// M-rma-request (criteria 180-191, 198-199, 202-203). One row per RMA
/// request; a customer may submit more than one over time for the same
/// order/line (e.g. a denied or expired request followed by a legitimate
/// resubmission) — this is NOT the same kind of idempotency problem as a
/// replayed webhook, so there is deliberately no `@@unique` on
/// `(orderRef, lineRef)` here. The idempotency this slice's design actually
/// protects (criterion 196/204) is REMEDY issuance, on `RmaRemedy` below.
model RmaRequest {
  id          String @id @default(uuid()) @db.Uuid
  /// Customer/support-facing reference (e.g. "RMA-000123"). Generated by a
  /// later repository task, not a database default — same precedent as
  /// `WarrantyClaim.claimReference`.
  rmaReference String @unique @map("rma_reference")

  orderRef    String  @map("order_ref")
  lineRef     String  @map("line_ref")
  customerRef String? @map("customer_ref")

  /// Resolved link when the (later) intake route can resolve `lineRef` to a
  /// `MasterVariant`. Nullable for the same reason as
  /// `WarrantyClaim.masterVariantId` — criterion 181 refuses an unresolvable
  /// ORDER/LINE, not an unresolvable catalog match.
  masterVariantId              String?        @map("master_variant_id") @db.Uuid
  masterVariant                MasterVariant? @relation(fields: [masterVariantId], references: [id])
  itemConfigurationDescription String         @map("item_configuration_description")

  purchaserEmail String @map("purchaser_email")

  /// Criterion 184 — the authoritative deadline anchor (policy §3), DATE
  /// (not timestamp) because every window/deadline rule in the policy is
  /// stated in whole calendar days.
  carrierConfirmedDeliveryDate DateTime @map("carrier_confirmed_delivery_date") @db.Date
  requestedAt                  DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  /// Criterion 184 — snapshot at request time, never recomputed later.
  calendarDaysSinceDelivery    Int      @map("calendar_days_since_delivery")

  reasonCategory    RmaReasonCategory @map("reason_category")
  reasonExplanation String            @map("reason_explanation")

  /// Criteria 186-188 — present if and only if the request both reaches a
  /// window (criterion 185's refusal already excludes day 31+) AND that
  /// window is `late`. See `rma_request_requested_remedy_coherent` in this
  /// slice's migration and `validateRequestedRemedy` in
  /// `app/app/domain/rma/window.ts`.
  requestedRemedyKind RmaRemedyKind? @map("requested_remedy_kind")

  /// Policy §7/§9 condition confirmations, captured at intake.
  confirmsUnwornBeyondInspection Boolean @map("confirms_unworn_beyond_inspection")
  confirmsUndamaged              Boolean @map("confirms_undamaged")
  confirmsUnalteredAfterDelivery Boolean @map("confirms_unaltered_after_delivery")
  confirmsOriginalPackagingIncluded Boolean @map("confirms_original_packaging_included")

  /// Criterion 183 — personalization/alteration eligibility, checked before
  /// approval (`app/app/domain/rma/eligibility.ts`), not merely displayed.
  isPersonalizedOrAltered         Boolean @map("is_personalized_or_altered")
  hasProductSpecificReturnOverride Boolean @default(false) @map("has_product_specific_return_override")

  /// Criterion 180 — "applicable return-policy acknowledgment." Required
  /// (NOT NULL FK), same evidence-not-checkbox pattern as
  /// `WarrantyClaim`'s two acknowledgments.
  returnPolicyAcknowledgmentId String         @map("return_policy_acknowledgment_id") @db.Uuid
  returnPolicyAcknowledgment   Acknowledgment @relation(fields: [returnPolicyAcknowledgmentId], references: [id])

  status RmaStatus @default(submitted)

  /// Criterion 185 — set at CREATION from `calendarDaysSinceDelivery` via
  /// `classifyReturnWindow`, not at approval: the classification is purely
  /// mechanical (no staff judgement involved, unlike overall approval, which
  /// also weighs item condition/reason-category eligibility), and
  /// `requestedRemedyKind` below is itself a customer choice made AT INTAKE
  /// that depends on already knowing the window — so the window must exist
  /// from row creation, not be deferred to a later staff action. Immutable
  /// thereafter (criterion 184): never recomputed if the day thresholds
  /// change later.
  windowKind         RmaWindowKind  @map("window_kind")
  approvedAt         DateTime?      @map("approved_at") @db.Timestamptz(6)
  approvedByActorRef String?        @map("approved_by_actor_ref")
  /// Criterion 191 — "eligible merchandise amount" (policy §3/§4), the
  /// merchandise-only value this remedy percentage applies to. Excludes tax,
  /// shipping, duties — the same excluded-charges definition D29 established
  /// for shipment merchandise value, applied here to the returned line.
  /// Required at creation, same reasoning as `windowKind` above: criterion
  /// 181 already requires the order/line to resolve before a row can exist
  /// at all, and this amount is part of that same resolution.
  eligibleMerchandiseAmountMinorUnits BigInt @map("eligible_merchandise_amount_minor_units")
  eligibleMerchandiseAmountCurrency   String @map("eligible_merchandise_amount_currency") @db.Char(3)
  /// Criterion 198 — "no later than 14 calendar days after original...
  /// delivery" (standard) or "within 10 calendar days after RMA approval"
  /// (late). Unlike `windowKind`, this genuinely depends on the approval
  /// timestamp for the late-window formula, so it is computed once, only at
  /// approval, uniformly for both windows (not conditionally at two
  /// different times depending on which window applies).
  receiveByDeadline  DateTime?      @map("receive_by_deadline") @db.Date

  deniedAt         DateTime? @map("denied_at") @db.Timestamptz(6)
  deniedByActorRef String?   @map("denied_by_actor_ref")
  denialReason     String?   @map("denial_reason")

  /// Criterion 198 — customer-paid, tracked, insured (policy §6). All
  /// nullable until the customer actually ships; insured value is money,
  /// present-together-or-absent-together with its currency.
  returnTrackingCarrier          String?  @map("return_tracking_carrier")
  returnTrackingNumber           String?  @map("return_tracking_number")
  returnInsuranceReference       String?  @map("return_insurance_reference")
  returnInsuredValueMinorUnits   BigInt?  @map("return_insured_value_minor_units")
  returnInsuredValueCurrency     String?  @map("return_insured_value_currency") @db.Char(3)
  returnShippedAt                DateTime? @map("return_shipped_at") @db.Timestamptz(6)

  expiredAt DateTime? @map("expired_at") @db.Timestamptz(6)

  /// Criterion 202 — set only by `record_receipt`, criterion 184-style gate
  /// for the condition decision.
  receivedAt          DateTime? @map("received_at") @db.Timestamptz(6)
  packageCondition    String?   @map("package_condition")
  itemCondition       String?   @map("item_condition")
  inspectionNotes     String?   @map("inspection_notes")
  inspectedByActorRef String?   @map("inspected_by_actor_ref")

  conditionDecision          RmaConditionDecision? @map("condition_decision")
  conditionDecisionReason    String?               @map("condition_decision_reason")
  conditionDecidedAt         DateTime?             @map("condition_decided_at") @db.Timestamptz(6)
  conditionDecidedByActorRef String?               @map("condition_decided_by_actor_ref")

  manualOverrideReason     String? @map("manual_override_reason")
  manualOverrideByActorRef String? @map("manual_override_by_actor_ref")

  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events RmaEvent[]
  remedy RmaRemedy?

  @@index([orderRef])
  @@index([status])
  @@index([customerRef])
  @@index([masterVariantId])
  @@map("rma_request")
}

/// Criteria 200-201. Append-only (this slice's migration extends
/// `prevent_evidence_mutation`/`prevent_evidence_truncate`, migrations
/// 20260913000100/20260914000000). Same shape as `WarrantyClaimEvent`:
/// who/when/from/to/why, plus `metadata` for the supporting facts recorded at
/// that specific transition.
model RmaEvent {
  id    String     @id @default(uuid()) @db.Uuid
  rmaId String     @map("rma_id") @db.Uuid
  rma   RmaRequest @relation(fields: [rmaId], references: [id])

  fromStatus RmaStatus? @map("from_status")
  toStatus   RmaStatus  @map("to_status")

  actorType ActorType @map("actor_type")
  actorRef  String?   @map("actor_ref")
  reason    String?
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([rmaId, createdAt])
  @@map("rma_event")
}

/// Criteria 189-197, 204. The remedy execution record. `@@unique([rmaId])` —
/// at most one remedy row per RMA, the same one-row-per-case idempotency
/// design as `WarrantyClaimRemedy`/`GroupBuyRefund`: a retried "issue this
/// remedy" call (in whatever job a later task builds) reads back this row
/// rather than inserting a second one.
///
/// D5/D10 — NO EXPIRATION FIELD EXISTS ON THIS MODEL. That is deliberate
/// (criterion 197): merchandise credit does not expire. If you are here to
/// add one, stop and re-read `docs/ARCHITECTURE-MVP1.md` D10 first.
///
/// D7 — `merchandiseAmountMinorUnits`/`restockingFeeMinorUnits` are computed
/// by THIS codebase from locked policy (criteria 189-191).
/// `shopifyTaxAdjustmentMinorUnits` and `actualRefundOrCreditMinorUnits` are
/// Shopify's own figures, populated only by the later job that calls
/// Shopify — nullable here because this task never populates them, and kept
/// as separate columns from the merchandise amount forever, not merged into
/// one "total" this codebase would have computed (criterion 193).
model RmaRemedy {
  id    String     @id @default(uuid()) @db.Uuid
  rmaId String     @unique @map("rma_id") @db.Uuid
  rma   RmaRequest @relation(fields: [rmaId], references: [id])

  kind   RmaRemedyKind
  status RmaRemedyStatus @default(pending)

  /// Criterion 191 — duplicated from `RmaRequest.eligibleMerchandiseAmountMinorUnits`
  /// at remedy-creation time so `rma_remedy_amount_matches_inputs` (this
  /// slice's migration) can be a same-row CHECK constraint, the same
  /// self-contained-row reasoning as `group_buy_refund_amount_matches_inputs`.
  eligibleMerchandiseAmountMinorUnits BigInt @map("eligible_merchandise_amount_minor_units")
  merchandiseAmountMinorUnits         BigInt @map("merchandise_amount_minor_units")
  restockingFeeMinorUnits             BigInt @map("restocking_fee_minor_units")
  currency                            String @map("currency") @db.Char(3)

  /// D7 — Shopify's own figures. See this model's header. Never computed by
  /// this codebase; never merged with the merchandise amount into one field.
  shopifyTaxAdjustmentMinorUnits BigInt? @map("shopify_tax_adjustment_minor_units")
  actualRefundOrCreditMinorUnits BigInt? @map("actual_refund_or_credit_minor_units")

  processorReference  String? @map("processor_reference")
  failureReason       String? @map("failure_reason")
  /// Criterion 194 — required when `status = staff_review_required`.
  staffReviewReason   String? @map("staff_review_reason")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  issuedAt  DateTime? @map("issued_at") @db.Timestamptz(6)

  @@map("rma_remedy")
}
