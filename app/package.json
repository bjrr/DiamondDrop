{
  "name": "carat-for-us-app",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs --fix",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:money-safety": "node ./scripts/check-money-safety.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "price-review": "tsx scripts/price-review.ts",
    "dev:group-buy": "tsx scripts/dev-group-buy-campaign.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-router/node": "7.18.3",
    "@react-router/serve": "7.18.3",
    "@shopify/shopify-app-react-router": "3.0.0",
    "@shopify/shopify-app-session-storage-prisma": "11.0.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "isbot": "^5.1.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.3",
    "@react-router/express": "7.18.3",
    "@react-router/fs-routes": "7.18.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "express": "^4.18.2",
    "prisma": "6.19.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "esbuild@0.17.6": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
