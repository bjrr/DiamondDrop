          "settings": {
            "title": "What is covered by the guarantee",
            "text": "<p>A <strong>recent, verified written quote for a custom piece</strong> from a real competing seller. Only a qualifying quote of this kind receives our guarantee and the fallback benefit.</p>"
          }
        },
        "review_only": {
          "type": "column",
          "settings": {
            "title": "What we will look at, but cannot guarantee",
            "text": "<p>An <strong>active online listing</strong>, or a <strong>competing Group Buy</strong>. We will review either of these honestly and tell you what we can do — but they carry <strong>no guarantee and no fallback benefit</strong>.</p>"
          }
        },
        "expiry": {
          "type": "column",
          "settings": {
            "title": "If a fallback benefit is issued",
            "text": "<p>It <strong>expires 90 calendar days after it is issued</strong>. A benefit cannot be combined with another, or claimed twice against the same purchase.</p>"
          }
        }
      },
