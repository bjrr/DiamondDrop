{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position">
                          {{- 'icon-discount.svg' | inline_asset_content -}}
                          {{ discount.title | escape }}
                          (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="totals">
                  <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
                  {%- comment -%}
                    R12 (docs/specs/SLICE-2B-CART-SURFACE-INVENTORY.md): the cart total is a
                    cross-line sum, which must not be duplicated in Liquid — it is always
                    pending here and applied by JS from the proxy's active merchandise total,
                    in either mode. See the 2B-3 handoff for the "always pending" rationale.
                  {%- endcomment -%}
                  <p class="totals__total-value">
                    <span data-carat-money="cart-total" data-carat-mode-pending>
                      <span class="visually-hidden">{{ 'sections.cart.pricing.calculating' | t }}</span>
                      <span aria-hidden="true">&nbsp;</span>
                    </span>
                  </p>
                </div>

                {%- comment -%}
                  Owner §3: card total, bank total and the applicable saving, shown
                  simultaneously at cart level — same unconditional/zero-not-hidden treatment
                  as the per-line breakdown in sections/main-cart-items.liquid. No line-id/
                  variant-id: these are cart-level, not per-line.
                {%- endcomment -%}
                <dl class="cart__bank-card-pricing">
                  <div class="cart__bank-card-pricing-row">
                    <dt>{{ 'sections.cart.pricing.card_total' | t }}:</dt>
                    <dd>
                      <span data-carat-money="cart-card-total" data-carat-mode-pending>
                        <span class="visually-hidden">{{ 'sections.cart.pricing.calculating' | t }}</span>
                        <span aria-hidden="true">&nbsp;</span>
                      </span>
                    </dd>
                  </div>
                  <div class="cart__bank-card-pricing-row">
                    <dt>{{ 'sections.cart.pricing.bank_payment_total' | t }}:</dt>
                    <dd>
                      <span data-carat-money="cart-bank-total" data-carat-mode-pending>
                        <span class="visually-hidden">{{ 'sections.cart.pricing.calculating' | t }}</span>
                        <span aria-hidden="true">&nbsp;</span>
                      </span>
                    </dd>
                  </div>
                  <div class="cart__bank-card-pricing-row">
                    <dt>{{ 'sections.cart.pricing.bank_payment_saving' | t }}:</dt>
                    <dd>
                      <span data-carat-money="cart-saving" data-carat-mode-pending>
                        <span class="visually-hidden">{{ 'sections.cart.pricing.calculating' | t }}</span>
                        <span aria-hidden="true">&nbsp;</span>
                      </span>
                    </dd>
                  </div>
                </dl>

                {%- comment -%}
                  Owner ruling, 2026-09-19 (relayed via the 2B-5 handoff): Card -> Bank is
                  asymmetric with Bank -> Card, on purpose. Bank -> Card raises what the
                  customer pays, so it is gated behind the reprice-confirm panel below
                  (owner §19). Card -> Bank only ever lowers it, so it needs no confirmation
                  -- one control, one click, entirely the JS owner's behaviour, keyed off
                  `data-carat-payment-mode-action="bank"`.

                  Shown only in Card mode (redundant in Bank mode -- the cart is already
                  there). Hidden with a plain `hidden` attribute rather than by Liquid
                  conditional existence, matching the reprice-confirm panel's own pattern
                  below rather than the accelerated-checkout suppression's pattern above:
                  this lets JS toggle both this control and that panel in place, from the
                  same mode-switch action, without depending on a full Section Rendering
                  re-fetch to keep them in sync -- see the reprice-confirm panel's own
                  comment for why that matters here.

                  References the Bank Payment Savings figure owner §3 already renders
                  unconditionally above (`cart-saving`) instead of adding an eleventh
                  `data-carat-money` kind for a duplicate number.
                {%- endcomment -%}
                <p
                  class="cart__switch-to-bank-payment"
                  data-carat-payment-mode-action-wrapper
                  {% if cart.attributes.carat_payment_mode == 'bank' %}
                    hidden
                  {% endif %}
                >
                  <button
                    type="button"
                    class="link underlined-link"
                    data-carat-payment-mode-action="bank"
                  >
                    {{ 'sections.cart.pricing.switch_to_bank_payment' | t }}
                  </button>
                  {{ 'sections.cart.pricing.switch_to_bank_payment_note' | t }}
                </p>

                <small class="tax-note caption-large rte">
                  {%- if cart.duties_included and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_included_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
                    {%- if shop.shipping_policy.body == blank -%}
                      {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
                    {%- else -%}
                      {{
                        'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html'
                        | t: link: shop.shipping_policy.url
                      }}
                    {%- endif -%}
                  {%- endif -%}
                </small>
              </div>
            {%- else -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                {%- comment -%}
                  Owner §20 (docs/SLICE-2-AND-GROUP-BUY-OWNER-DECISIONS.md): the cart offers
                  Card Checkout and Bank Payment Checkout.

                  UPDATED 2026-09-19 per owner §19's second sentence and the 2B-5 handoff.
                  The price-safety half of the original note still holds unchanged: this
                  button is Shopify's own native checkout submit, and Shopify always charges
                  the published (Card) variant price for it regardless of any cart attribute,
                  so a card payment can never complete at the lower Bank Payment figure. What
                  the original note missed is the OTHER half of §19 -- "the cart/order must
                  reprice to Regular/Card pricing before payment and show the updated total"
                  -- which is about the customer's own cart/order record and their
                  understanding, not about the amount charged. Left alone, a Bank-mode
                  customer could click straight through to checkout while
                  `cart.attributes.carat_payment_mode` still said "bank" on the order, and
                  would see the higher Card total appear only once already at Shopify's
                  checkout, with nothing on this page explaining why.

                  So in Bank mode this button's click is intercepted (JS, not owned here,
                  keyed off `data-carat-checkout-action="card"`): switch the cart to Card
                  mode, reprice, reveal the confirmation panel below with the updated total
                  already visible in this page's own Card Total figure, and require the
                  separate `data-carat-checkout-action="card-confirm"` action to actually
                  proceed. In Card mode there is nothing to intercept -- the button submits
                  exactly as Dawn's does today.
                {%- endcomment -%}
                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  data-carat-checkout-action="card"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.card_checkout' | t }}
                </button>

                {%- comment -%}
                  Owner §19 (docs/SLICE-2-AND-GROUP-BUY-OWNER-DECISIONS.md) / 2B-5 handoff.
                  Hidden by default; the JS above reveals it once the cart has actually
                  repriced to Card mode, and hides/disables the plain Card Checkout button
                  above so only one action is available at a time. This is the customer's
                  SECOND, EXPLICIT action -- ordinary native submit, no further interception
                  -- because by the time this panel is visible the cart is already in Card
                  mode. `role="status"` because this is the expected, correct consequence of
                  choosing to pay by card, not an error or a warning; the message says what
                  changed and why rather than sounding like something went wrong. It does not
                  duplicate the total as a new money figure -- the Card Total already shown
                  unconditionally above (owner §3's simultaneous breakdown) is the same
                  number and updates in place, so the copy points to it instead of adding an
                  eleventh `data-carat-money` kind the R12 DOM contract does not define.

                  COPY FLAGGED FOR OWNER SIGN-OFF (2B-5 handoff): both strings below are
                  material, customer-facing pricing communication.
                {%- endcomment -%}
                <div class="cart__card-checkout-confirm" data-carat-card-checkout-confirm hidden>
                  <p class="cart__card-checkout-confirm-message" role="status">
                    {{ 'sections.cart.pricing.card_checkout_reprice_notice' | t }}
                  </p>
                  <button
                    type="submit"
                    class="cart__checkout-button button"
                    name="checkout"
                    form="cart"
                    data-carat-checkout-action="card-confirm"
                    {% if cart == empty %}
                      disabled
                    {% endif %}
                  >
                    {{ 'sections.cart.card_checkout_confirm' | t }}
                  </button>
                </div>

                {%- comment -%}
                  Slice 2C task 2C-6 (docs/specs/SLICE-2C-BANK-PAYMENT-CHECKOUT.md criteria
                  83-86, 94-95, D20). Previously a clearly-marked stub wired to no checkout
                  path (owner §20 / 2B-3 brief); now opens the details-form dialog
                  (snippets/bank-payment-checkout-dialog.liquid) via
                  theme/assets/bank-payment-checkout.js's document-level delegated click
                  listener on `data-carat-checkout-action="bank-payment"` — same attribute
                  family as the Card Checkout actions above (`data-carat-checkout-action=
                  "card"` / `"card-confirm"`), not a bespoke stub marker anymore.
                  type="button" so it still cannot accidentally submit the Card checkout form.
                {%- endcomment -%}
                <button
                  type="button"
                  id="bank-payment-checkout"
                  class="cart__checkout-button button button--secondary"
                  data-carat-checkout-action="bank-payment"
                  aria-describedby="bank-payment-checkout-note"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                >
                  {{ 'sections.cart.bank_payment_checkout' | t }}
                </button>
                <p id="bank-payment-checkout-note" class="caption-large rte">
                  {{ 'sections.cart.bank_payment_checkout_note' | t }}
                </p>
              </div>

              {%- comment -%}
                L4 (docs/specs/SLICE-2B-CART-SURFACE-INVENTORY.md): accelerated/dynamic
                checkout bypasses the mode-aware cart entirely and always charges the
                published Card price. In Bank mode that is a broken promise, not a pricing
                error (the customer sees the lower Bank figure, then a one-click accelerated
                button charges the higher Card price with no explanation) — so it is
                suppressed while `carat_payment_mode` is "bank", per owner §19. Present
                normally in Card mode.

                UNIFIED WITH F1 (2026-09-19, team-lead ruling). Previously gated purely by
                existence (`additional_checkout_buttons and cart.attributes.carat_payment_mode
                != 'bank'`). That is safe here specifically because a cart-level mode switch
                always goes through `/cart/update.js` and the existing L3 cart-section
                resync, so the next server render corrects it — but it leaves a real, if
                narrow, window: that resync is a network call, and if it fails, times out, or
                races a concurrent cart update, the cart genuinely IS in Bank mode server-side
                while this DOM is still stale Card-mode markup, with an accelerated-checkout
                button live in it. Same bypass F1 closed, smaller probability, identical
                consequence — and two different treatments of the same requirement in two
                files is itself a hazard (a future maintainer has no way to tell the
                difference is meaningful rather than accidental).

                So this now matches F1's pattern (and the confirm panel / switch-to-bank
                control) exactly, using the SAME wrapper attribute so `mode-switch`'s existing
                selector-driven hide logic (already run on every apply, already covering both
                the switch-to-bank control and F1) covers this surface for free: the element
                always renders whenever `additional_checkout_buttons` is true (that alone
                gates existence), wrapped in `data-carat-dynamic-checkout-wrapper` -- wrapped,
                not reimplemented, since `content_for_additional_checkout_buttons` is
                Shopify-generated -- with `hidden` set at render time purely from
                `cart.attributes.carat_payment_mode`.
              {%- endcomment -%}
              {%- if additional_checkout_buttons -%}
                <div
                  class="cart__dynamic-checkout-buttons additional-checkout-buttons"
                  data-carat-dynamic-checkout-wrapper
                  {% if cart.attributes.carat_payment_mode == 'bank' %}
                    hidden
                  {% endif %}
                >
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },    
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
