{%- comment -%}
  Jewelry product design: bracelet special-size request.
  Purchasable lengths are ONLY the product's real variants (native Length/Size option).
  Lengths listed in Theme settings > Jewelry product design > "Request-only bracelet
  lengths" are offered here as a quote request through the store's own contact form
  (it reaches the store's contact email). They never become cart items.
  Hidden when that setting is empty.
  Accepts: product, section, variant
{%- endcomment -%}
{%- liquid
  assign jpd_sizes = settings.jpd_bracelet_request_sizes | split: ','
  assign jpd_form_id = 'jpd-bracelet-request-' | append: section.id
  assign jpd_size_count = 0
  for s in jpd_sizes
    assign s_clean = s | strip
    if s_clean != blank
      assign jpd_size_count = jpd_size_count | plus: 1
    endif
  endfor
-%}
{%- if jpd_size_count > 0 -%}
  <div class="jpd-bracelet" data-jpd-bracelet>
    {%- form 'contact', id: jpd_form_id, class: 'jpd-bracelet__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="jpd-bracelet__success" role="status" tabindex="-1" data-jpd-focus>
          {{ settings.jpd_bracelet_success | default: 'Thank you. We have received your size request and will reply by email.' | escape }}
        </p>
      {%- else -%}
        <details class="jpd-bracelet__details"{% if form.errors %} open{% endif %}>
          <summary class="link">{{ settings.jpd_bracelet_heading | default: 'Need a different length? Request a size' | escape }}</summary>
          {%- if form.errors -%}
            <div class="jpd-error" role="alert" tabindex="-1" data-jpd-focus>{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <p class="caption">{{ settings.jpd_bracelet_note | default: 'Special-order lengths are quoted individually and are not added to your cart.' | escape }}</p>
          <input type="hidden" name="contact[Request]" value="Bracelet size request">
          <input type="hidden" name="contact[Product]" value="{{ product.title | escape }}">
          <input type="hidden" name="contact[Variant]" value="{{ variant.title | escape }}" data-jpd-variant-title>
          <input type="hidden" name="contact[Page]" value="{{ shop.url }}{{ product.url }}">
          <div class="field">
            <select id="{{ jpd_form_id }}-size" class="field__input jpd-bracelet__select" name="contact[Requested length]" required>
              <option value="">{{ 'jpd.bracelet.choose' | t }}</option>
              {%- for s in jpd_sizes -%}
                {%- assign s_clean = s | strip -%}
                {%- if s_clean != blank -%}<option value="{{ s_clean | escape }}">{{ s_clean | escape }}</option>{%- endif -%}
              {%- endfor -%}
            </select>
            <label class="field__label" for="{{ jpd_form_id }}-size">{{ 'jpd.bracelet.length' | t }}</label>
          </div>
          <div class="field">
            <input id="{{ jpd_form_id }}-name" class="field__input" type="text" name="contact[name]" autocomplete="name" required value="{{ form.name | escape }}" placeholder="{{ 'jpd.bracelet.name' | t }}">
            <label class="field__label" for="{{ jpd_form_id }}-name">{{ 'jpd.bracelet.name' | t }}</label>
          </div>
          <div class="field">
            <input id="{{ jpd_form_id }}-email" class="field__input" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email | escape }}" placeholder="{{ 'jpd.bracelet.email' | t }}">
            <label class="field__label" for="{{ jpd_form_id }}-email">{{ 'jpd.bracelet.email' | t }}</label>
          </div>
          <button type="submit" class="button button--secondary">{{ 'jpd.bracelet.submit' | t }}</button>
        </details>
      {%- endif -%}
    {%- endform -%}
  </div>
{%- endif -%}
