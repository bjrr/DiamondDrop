# Copy to .env for local development. Placeholders only — never commit real
# values. Full variable set per docs/ARCHITECTURE-MVP1.md §7.
#
# Vars marked (Slice 0) are validated at startup and must be present for the
# app to boot at all — see app/lib/env.server.ts. Any non-empty placeholder
# works locally; none of them need to be real Shopify-issued credentials yet
# (open decision D1 — see docs/ARCHITECTURE-MVP1.md §12). Vars marked
# (reserved) are documented now but not yet required — they become required
# in the slice noted once that slice's code path reads them.

# --- Slice 0: required to boot -----------------------------------------
APP_ENV=development
DATABASE_URL="postgresql://carat:carat_dev_password@localhost:5432/carat_dev?schema=public"
SESSION_SECRET="dev_session_secret_change_me_please_______"
CRON_SECRET="dev_cron_secret_change_me_please__________"
SHOPIFY_API_SECRET="dev_shopify_app_secret_placeholder________"
SHOPIFY_APP_PROXY_SUBPATH="carat"

# --- Shopify admin OAuth (slice 2 / D13) --------------------------------
# SHOPIFY_API_KEY is the app's Client ID. PUBLIC — it ships in the app
# frontend and is committed in shopify.app.caratforus-development.toml.
# The client SECRET is SHOPIFY_API_SECRET above and must never be committed.
# Scopes are least-privilege and must match [access_scopes] in that .toml.
SHOPIFY_API_KEY=
SHOPIFY_SCOPES="read_products,write_products,read_inventory"
SHOPIFY_APP_URL="https://example.ngrok-free.app"

# --- Reserved: first Shopify Admin API call (slice 1+) ------------------
SHOPIFY_ADMIN_API_VERSION="2026-07"

# --- Reserved: first file upload — warranty/RMA/quote evidence (slice 4/5/9/10) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Reserved: first transactional email — Group Buy milestones (slice 7+) ---
EMAIL_API_KEY=
EMAIL_FROM=

# --- Reserved: first admin authentication (slice 2+) --------------------
STAFF_EMAIL_ALLOWLIST=

# --- Integration test database -----------------------------------------
# LEAVE THIS UNSET. Unset means the integration suite builds its disposable
# per-run database on the LOCAL Postgres named by DATABASE_URL, and
# vitest.integration.config.ts uses a 45s per-test timeout.
#
# Setting it points the suite at a remote test database and raises that
# timeout to 600s — both keyed off this one variable. Measured 2026-10-09:
# the same 81 files / 1181 tests take 4m41s locally and ~2.5 HOURS against
# a Fly database through `fly mpg proxy`, because the pricing job issues a
# very large number of small queries that are free locally and expensive
# across a network.
#
# Set it only for deliberate pre-release verification, and run nothing else
# against that database while it does — parallel suites against one proxied
# remote database produced 470 connection errors that presented as 7
# assertion failures and cost a day of misdiagnosis.
INTEGRATION_DATABASE_URL=

# --- Live-gate fixtures (tests/live/*.ts) -------------------------------
# NOT application configuration. These identify purpose-built test fixtures
# on the dev store, and the gates REFUSE to run without them rather than
# inventing a placeholder — see each gate's own guard.
#
# Two DISTINCT manually-created Shopify test customers. Distinct is
# load-bearing: the cross-customer binding assertions pass vacuously with one
# identity, which is why the gates error if only one is set. Created by hand
# in the admin because minting them needs `write_customers`, a scope the app
# deliberately does not request.
CARAT_LIVE_GATE_CUSTOMER_A=
CARAT_LIVE_GATE_CUSTOMER_B=
# A purpose-built test product variant. The warranty/RMA gates create a REAL
# order against it, so never point this at a variant a customer could buy.
CARAT_LIVE_GATE_VARIANT_GID=
# Defaults to https://caratforus.fly.dev when unset.
CARAT_LIVE_GATE_APP_URL=
# Where gate-generated confirmation emails go. Defaults to Resend's
# accept-and-discard sink (delivered@resend.dev) rather than a fabricated
# address, so gate runs do not generate bounces against our sending domain.
CARAT_LIVE_GATE_SINK_EMAIL=
